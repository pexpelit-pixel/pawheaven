export function buildObservatoryLevel5({ group, box, solids }) {
  group.userData.disposeTextures = group.userData.disposeTextures || [];
  group.userData.disposeMaterials = group.userData.disposeMaterials || [];
  group.userData.disposeGeometries = group.userData.disposeGeometries || [];
  group.userData.disposed = false;

  addPhotoGallery({ group, box });
  const symbolPuzzle = buildRunePuzzle({ group, box });
  const mosaic = buildMosaic({ group, box });
  const weightPuzzle = buildWeightPuzzle({ group, box, solids });
  const lightPuzzle = buildLightPuzzle({ group, box });
  const clockPuzzle = buildClockPuzzle({ group, box });
  const princess = buildPrincess({ group, box });
  const rally = buildRally({ group, box, solids });
  const finishDoor = buildFinishDoor({ group, box });

  const rewardDrops = {
    scepter: makeArtifact('scepter'),
    ring: makeArtifact('ring'),
    crown: makeArtifact('crown'),
    armor: makeArtifact('armor')
  };
  const dropPositions = {
    scepter: [0, FLOOR_Y + 1.12, 18.0],
    ring: [0, FLOOR_Y + 1.12, 36.0],
    crown: [0, FLOOR_Y + 1.12, 54.0],
    armor: [4.6, 4.18, 89.0]
  };
  for (const [kind, artifact] of Object.entries(rewardDrops)) {
    artifact.visible = false;
    artifact.position.set(...dropPositions[kind]);
    group.add(artifact);
  }

  return {
    type: 'observatory',
    completed: false,
    phase: 'gallery',
    symbolPuzzle,
    mosaic,
    weightPuzzle,
    lightPuzzle,
    clockPuzzle,
    princess,
    rally,
    finishDoor,
    rewardDrops,
    dropPositions,
    pendingItem: null,
    pickupNextPhase: null,
    collected: new Set(),
    installed: new Set(),
    promptTick: 0
  };
}

function nearestByXZ(items, position, getPoint, radius) {
  let nearest = null;
  let bestDistance = radius;
  for (const item of items) {
    const point = getPoint(item);
    if (!point) continue;
    const distance = Math.hypot(position.x - point.x, position.z - point.z);
    if (distance < bestDistance) {
      nearest = item;
      bestDistance = distance;
    }
  }
  return nearest;
}

function updateMosaic(s, position, dt, consumeInteract, setPrompt) {
  const mosaic = s.mosaic;
  if (mosaic.swapAnimation) {
    const animation = mosaic.swapAnimation;
    animation.elapsed += dt;
    const t = clamp01(animation.elapsed / animation.duration);
    const eased = t * t * (3 - 2 * t);
    animation.first.mesh.position.lerpVectors(animation.firstStart, animation.firstTarget, eased);
    animation.second.mesh.position.lerpVectors(animation.secondStart, animation.secondTarget, eased);
    if (t >= 1) {
      animation.first.mesh.position.copy(animation.firstTarget);
      animation.second.mesh.position.copy(animation.secondTarget);
      mosaic.swapAnimation = null;
      mosaic.isSolved = mosaic.tiles.every((tile) => tile.pieceId === tile.cellIndex);
      if (mosaic.isSolved) {
        mosaic.selectionRing.visible = false;
        s.phase = 'weights';
        setPrompt('Mosaik pulih! Gerbang ruang keseimbangan terbuka. Dorong tiga kubus berat ke pelat emas.');
        return;
      }
    }
    return;
  }

  if (consumeInteract()) {
    const tile = nearestByXZ(mosaic.tiles, position, (entry) => entry.mesh.position, 1.62);
    if (!tile) {
      mosaic.selectedTile = null;
      mosaic.selectionRing.visible = false;
      setPrompt('Memory Mosaic: dekati salah satu kubus gambar, lalu tekan INTERAKSI.');
      return;
    }
    if (!mosaic.selectedTile) {
      mosaic.selectedTile = tile;
      mosaic.selectionRing.visible = true;
      mosaic.selectionRing.position.set(tile.mesh.position.x, tile.mesh.position.y + 0.12, tile.mesh.position.z);
      setPrompt('Kubus dipilih. Dekati kubus pasangan lalu tekan INTERAKSI untuk menukar tempatnya.');
      return;
    }
    if (mosaic.selectedTile === tile) {
      mosaic.selectedTile = null;
      mosaic.selectionRing.visible = false;
      setPrompt('Pilihan kubus dibatalkan. Pilih potongan lain yang ingin dipindahkan.');
      return;
    }
    const first = mosaic.selectedTile;
    const firstCell = first.cellIndex;
    const secondCell = tile.cellIndex;
    first.cellIndex = secondCell;
    tile.cellIndex = firstCell;
    first.mesh.userData.cellIndex = secondCell;
    tile.mesh.userData.cellIndex = firstCell;
    mosaic.swapAnimation = {
      first,
      second: tile,
      firstStart: first.mesh.position.clone(),
      secondStart: tile.mesh.position.clone(),
      firstTarget: new THREE.Vector3(mosaic.cells[secondCell].x, mosaic.cells[secondCell].y, mosaic.cells[secondCell].z),
      secondTarget: new THREE.Vector3(mosaic.cells[firstCell].x, mosaic.cells[firstCell].y, mosaic.cells[firstCell].z),
      elapsed: 0,
      duration: 0.26
    };
    mosaic.selectedTile = null;
    mosaic.selectionRing.visible = false;
    setPrompt('Kubus bergeser. Cocokkan semua sambungan gambar hingga mosaik pulih.');
    return;
  }

  if (mosaic.selectedTile) {
    mosaic.selectionRing.position.set(
      mosaic.selectedTile.mesh.position.x,
      mosaic.selectedTile.mesh.position.y + 0.12,
      mosaic.selectedTile.mesh.position.z
    );
    setPrompt('Kubus terpilih. Cari pasangan potongan gambar dan tekan INTERAKSI.');
  } else {
    setPrompt('The Memory Mosaic: geser 12 kubus gambar hingga menjadi satu foto utuh. Gunakan INTERAKSI pada dua kubus untuk menukar posisi.');
  }
}

function updateRally(system, s, position, dt, consumeInteract, setPrompt) {
  const rally = s.rally;
  const ball = rally.ball.position;
  const target = rally.opponent.position;
  const record = system.activePhysics?.dynamicPropsById?.get(rally.ballId);
  const step = Math.min(0.05, Math.max(0, dt));

  if (rally.ballInFlight) {
    rally.flightElapsed += step;
    const arrived = ball.z >= target.z - 1.0 && Math.abs(ball.x - target.x) <= 1.9;
    if (!arrived && rally.flightElapsed <= 2.8) {
      setPrompt('Braidel Rally: bola menuju lawan. Reli berhasil ' + rally.rallies + '/3.');
      return;
    }
    rally.lastSuccess = arrived || (ball.z > target.z - 1.7 && Math.abs(ball.x - target.x) <= 2.45);
    rally.ballInFlight = false;
    rally.returning = true;
    rally.returnElapsed = 0;
    rally.returnStart = { x: ball.x, y: ball.y, z: ball.z };
    record?.body?.setLinvel({ x: 0, y: 0, z: 0 }, true);
    record?.body?.setAngvel({ x: 0, y: 0, z: 0 }, true);
  }

  if (rally.returning) {
    rally.returnElapsed += step;
    const t = clamp01(rally.returnElapsed / 0.72);
    const eased = t * t * (3 - 2 * t);
    const start = rally.returnStart;
    const origin = rally.ballStart;
    const next = {
      x: THREE.MathUtils.lerp(start.x, origin.x, eased),
      y: THREE.MathUtils.lerp(start.y, origin.y, eased) + Math.sin(t * Math.PI) * 0.62,
      z: THREE.MathUtils.lerp(start.z, origin.z, eased)
    };
    rally.ball.position.set(next.x, next.y, next.z);
    if (record) {
      record.body.setTranslation(next, true);
      record.body.setLinvel({ x: 0, y: 0, z: 0 }, true);
      record.body.setAngvel({ x: 0, y: 0, z: 0 }, true);
    }
    if (t >= 1) {
      rally.returning = false;
      rally.ball.position.set(origin.x, origin.y, origin.z);
      if (record) {
        record.body.setTranslation(origin, true);
        record.body.setLinvel({ x: 0, y: 0, z: 0 }, true);
        record.body.setAngvel({ x: 0, y: 0, z: 0 }, true);
      }
      if (rally.lastSuccess) rally.rallies += 1;
      if (rally.rallies >= 3) {
        s.phase = 'princess';
        setPrompt('Tiga reli berhasil! Gerbang menuju Putri Raja terbuka. Bawa empat perlengkapan ke patung kerajaan.');
        return;
      }
      setPrompt(rally.lastSuccess
        ? 'Reli berhasil! ' + rally.rallies + '/3. Bola kembali, lanjutkan.'
        : 'Bola meleset. Coba lagi dan arahkan ke sisi Braidel.');
    }
    return;
  }

  if (Math.hypot(position.x - ball.x, position.z - ball.z) <= 1.6) {
    setPrompt('Braidel Last Rally: dekati bola dan tekan INTERAKSI untuk memukul ke arah Braidel. Target ' + rally.rallies + '/3.');
    if (consumeInteract() && record) {
      record.body.setLinvel({ x: 0, y: 0, z: 0 }, true);
      record.body.setAngvel({ x: 0, y: 0, z: 0 }, true);
      const dx = target.x - ball.x;
      const dz = target.z - ball.z;
      record.body.applyImpulse({
        x: THREE.MathUtils.clamp(dx, -2.6, 2.6) * 1.25,
        y: 0.62,
        z: Math.max(3.4, dz * 0.92)
      }, true);
      rally.ballInFlight = true;
      rally.flightElapsed = 0;
    }
  } else {
    setPrompt('Braidel Last Rally: dekati bola di lapangan dan menangkan tiga reli.');
  }
}

export function updateObservatoryLevel5(system, level, position, dt) {
  const s = system.special;
  if (!s) return false;
  const step = Math.min(0.05, Math.max(0, Number(dt) || 0));
  if (s.completed) {
    if (s.finishDoor?.opened) {
      s.finishDoor.panel.position.y = THREE.MathUtils.damp(s.finishDoor.panel.position.y, 4.5, 2.3, step);
    }
    return false;
  }
  const near = (point, radius = 1.6) => Math.hypot(position.x - point.x, position.z - point.z) <= radius;
  const consumeInteract = () => {
    const value = Boolean(system.game.input?.consumeInteract?.());
    if (value) system.game.input?.consumeLongInteract?.();
    return value;
  };
  const setPrompt = (message) => system.setPrompt(message);
  const revealItem = (kind, nextPhase, message) => {
    s.pendingItem = kind;
    s.pickupNextPhase = nextPhase;
    s.rewardDrops[kind].visible = true;
    s.phase = 'pickup';
    setPrompt(message);
  };

  if (s.phase === 'gallery') {
    if (near({ x: 0, z: -18.0 }, 7.5)) {
      s.phase = 'symbols';
      setPrompt('Memory Gallery selesai. Prasasti di depan menyimpan urutan simbol kerajaan.');
    } else {
      setPrompt('Memory Gallery: jelajahi foto-foto kenangan yang dipajang di sepanjang observatorium. Ikuti jembatan menuju prasasti kerajaan.');
      return true;
    }
  }

  if (s.phase === 'symbols') {
    const puzzle = s.symbolPuzzle;
    const nearest = nearestByXZ(puzzle.runes, position, (rune) => rune.position, 1.75);
    if (nearest) {
      setPrompt('The Silent Symbols: petunjuk di prasasti menunjukkan BINTANG, BULAN, lalu MATAHARI. Dekati simbol dan tekan INTERAKSI.');
      if (consumeInteract()) {
        const expected = puzzle.sequence[puzzle.index];
        if (nearest.symbol === expected) {
          nearest.solved = true;
          nearest.mesh.children[1].material.emissiveIntensity = 1.25;
          puzzle.index++;
          if (puzzle.index >= puzzle.sequence.length) {
            s.phase = 'mosaic';
            setPrompt('Urutan prasasti benar! Gerbang Memory Mosaic terbuka.');
          } else {
            setPrompt('Simbol benar. Lanjutkan urutan ' + (puzzle.index + 1) + '/3.');
          }
        } else {
          puzzle.index = 0;
          for (const rune of puzzle.runes) {
            rune.solved = false;
            rune.mesh.children[1].material.emissiveIntensity = 0.48;
          }
          setPrompt('Urutan salah. Prasasti meredup, amati petunjuk dan coba dari awal.');
        }
      }
    } else {
      setPrompt('The Silent Symbols: amati prasasti bercahaya, lalu aktifkan simbol BINTANG, BULAN, dan MATAHARI secara berurutan.');
    }
    return true;
  }

  if (s.phase === 'mosaic') {
    updateMosaic(s, position, step, consumeInteract, setPrompt);
    return true;
  }

  if (s.phase === 'weights') {
    const allPlaced = s.weightPuzzle.crates.every((crate) => {
      const record = system.activePhysics?.dynamicPropsById?.get(crate.id);
      const point = record?.body?.translation?.() || record?.group?.position;
      return point && Math.hypot(point.x - crate.target.x, point.z - crate.target.z) <= 0.78;
    });
    if (allPlaced) {
      s.weightPuzzle.completed = true;
      revealItem('scepter', 'light',
        'Keseimbangan sempurna! Tongkat Kerajaan muncul. Dekati dan tekan INTERAKSI untuk mengambilnya.');
    } else {
      const placed = s.weightPuzzle.crates.filter((crate) => {
        const record = system.activePhysics?.dynamicPropsById?.get(crate.id);
        const point = record?.body?.translation?.() || record?.group?.position;
        return point && Math.hypot(point.x - crate.target.x, point.z - crate.target.z) <= 0.78;
      }).length;
      setPrompt('Tongkat Kerajaan: “Menopang sang putri berdiri lebih teguh, dalam genggaman setianya.” Dorong tiga peti ke lingkaran emas. Pelat aktif ' + placed + '/3.');
    }
    return true;
  }

  if (s.phase === 'pickup') {
    const kind = s.pendingItem;
    const artifact = s.rewardDrops[kind];
    const point = artifact.position;
    if (near(point, 1.85)) {
      setPrompt('Perlengkapan ditemukan: ' + ({
        scepter: 'Tongkat Kerajaan',
        ring: 'Cincin Permata',
        crown: 'Mahkota Emas',
        armor: 'Baju Zirah'
      }[kind]) + '. Tekan INTERAKSI untuk mengambil.');
      if (consumeInteract()) {
        artifact.visible = false;
        s.collected.add(kind);
        const next = s.pickupNextPhase;
        s.pendingItem = null;
        s.pickupNextPhase = null;
        s.phase = next;
        setPrompt('Perlengkapan tersimpan. Lanjutkan ke ruang teka-teki berikutnya.');
      }
    } else {
      setPrompt('Perlengkapan kerajaan telah muncul. Dekati cahaya penanda untuk mengambilnya.');
    }
    return true;
  }

  if (s.phase === 'light') {
    const puzzle = s.lightPuzzle;
    const nearest = nearestByXZ(puzzle.mirrors, position, (mirror) => mirror.root.position, 1.9);
    if (nearest) {
      setPrompt('Cincin Permata: “Memeluk tanpa lengan, melingkar tanpa ujung.” Putar tiga prisma hingga penunjuknya sejajar. Tekan INTERAKSI untuk memutar prisma.');
      if (consumeInteract()) {
        nearest.step = (nearest.step + 1) % 4;
        nearest.root.rotation.y = nearest.step * Math.PI * 0.5;
        const solved = puzzle.mirrors.every((mirror) => mirror.step === mirror.targetStep);
        if (solved) {
          puzzle.complete = true;
          revealItem('ring', 'clockwork',
            'Cahaya menyatu! Cincin Permata muncul di altar. Ambil sebelum melanjutkan.');
        } else {
          setPrompt('Prisma berputar. Periksa lagi arah ketiga pantulan cahaya.');
        }
      }
    } else {
      setPrompt('Cincin Permata: “Memeluk tanpa lengan, melingkar tanpa ujung.” Amati jalur cahaya, lalu putar tiga prisma hingga penunjuk masing-masing cocok.');
    }
    return true;
  }

  if (s.phase === 'clockwork') {
    const puzzle = s.clockPuzzle;
    puzzle.elapsed += step;
    puzzle.pendulum.rotation.z = Math.sin(puzzle.elapsed * 1.65) * 0.48;
    const nearest = nearestByXZ(puzzle.gears, position, (gear) => gear.root.position, 2.0);
    if (nearest) {
      setPrompt('Mahkota Emas: “Bertahta di puncak kepala, lambang kemuliaan sang putri.” Putar roda gigi hingga penanda emas sejajar. Tekan INTERAKSI untuk memutar roda.');
      if (consumeInteract()) {
        nearest.step = (nearest.step + 1) % 4;
        nearest.root.rotation.y = nearest.step * Math.PI * 0.5;
        const solved = puzzle.gears.every((gear) => gear.step === gear.targetStep);
        if (solved) {
          puzzle.complete = true;
          revealItem('crown', 'labyrinth',
            'Mekanisme jam selaras! Mahkota Emas ditemukan di puncak jam. Ambil untuk membuka jalur labirin.');
        } else {
          setPrompt('Satu roda bergeser. Dengarkan irama mekanisme dan cocokkan seluruh penanda.');
        }
      }
    } else {
      setPrompt('Mahkota Emas: “Bertahta di puncak kepala, lambang kemuliaan sang putri.” Amati pendulum dan tiga roda gigi, lalu cocokkan penanda emas.');
    }
    return true;
  }

  if (s.phase === 'labyrinth') {
    const exit = { x: 4.6, z: 89.0 };
    if (near(exit, 2.2) && Math.abs(position.y - 3.0) <= 0.62) {
      revealItem('armor', 'rally',
        'Labirin tertaklukkan! Baju Zirah ditemukan. Ambil perlengkapan terakhir sebelum menantang Braidel.');
    } else {
      setPrompt('Baju Zirah: “Menyelimuti tubuh sekeras baja, melindungi kehormatan.” Lewati papan fase yang berganti, jembatan bergerak, dan dua batang hologram. Capai dek keluar untuk menemukannya.');
    }
    return true;
  }

  if (s.phase === 'rally') {
    updateRally(system, s, position, step, consumeInteract, setPrompt);
    return true;
  }

  if (s.phase === 'princess') {
    const statuePoint = { x: s.princess.statue.position.x, z: s.princess.statue.position.z };
    if (near(statuePoint, 3.5)) {
      const nextItem = s.princess.installOrder.find((kind) => !s.installed.has(kind));
      if (!nextItem) {
        s.phase = 'complete';
        s.completed = true;
      } else {
        setPrompt('The Princess of Forgotten Kingdom: pasangkan ' + ({
          ring: 'Cincin Permata',
          crown: 'Mahkota Emas',
          scepter: 'Tongkat Kerajaan',
          armor: 'Baju Zirah'
        }[nextItem]) + ' pada patung. Tekan INTERAKSI.');
        if (consumeInteract()) {
          if (!s.collected.has(nextItem)) {
            setPrompt('Item belum ditemukan: ' + nextItem + '.');
          } else {
            const artifact = s.rewardDrops[nextItem];
            const anchor = s.princess.anchors[nextItem];
            artifact.visible = true;
            anchor.add(artifact);
            artifact.position.set(0, 0, 0);
            artifact.scale.setScalar(nextItem === 'armor' ? 0.88 : 0.78);
            s.installed.add(nextItem);
            setPrompt('Berhasil dipasang: ' + ({
              ring: 'Cincin Permata',
              crown: 'Mahkota Emas',
              scepter: 'Tongkat Kerajaan',
              armor: 'Baju Zirah'
            }[nextItem]) + '.');
            if (s.installed.size >= 4) {
              s.completed = true;
              s.phase = 'complete';
              s.finishDoor.opened = true;
              setPrompt('SANG PUTRI TELAH DIPULIHKAN! Gerbang FINISH kerajaan terbuka.');
              const plate = system.activeArena?.userData?.finishPressurePlate;
              if (plate) plate.visible = true;
              if (system.questObject) system.questObject.visible = true;
            }
          }
        }
      }
    } else {
      setPrompt('Tiga reli dimenangkan. Lanjutkan ke singgasana Putri Raja dan pasangkan empat perlengkapan kerajaan.');
    }
    return true;
  }

  if (s.phase === 'complete') {
    s.finishDoor.panel.position.y = THREE.MathUtils.damp(s.finishDoor.panel.position.y, 4.5, 2.3, step);
    return false;
  }

  return true;
}
