import * as THREE from 'three';
import album0Asset from '../world/skin/object/album0.webp';
import album1Asset from '../world/skin/object/album1.webp';
import album2Asset from '../world/skin/object/album2.webp';
import album3Asset from '../world/skin/object/album3.webp';

const FLOOR_Y = 0.42;
const clamp01 = (value) => Math.max(0, Math.min(1, value));

function makeMat(color, metalness = 0.08, roughness = 0.62, emissive = null) {
  return new THREE.MeshStandardMaterial({
    color,
    metalness,
    roughness,
    flatShading: true,
    ...(emissive ? { emissive, emissiveIntensity: 0.48 } : {})
  });
}

function addMesh(parent, geometry, material, name, position = [0, 0, 0]) {
  const mesh = new THREE.Mesh(geometry, material);
  mesh.name = name;
  mesh.position.set(position[0], position[1], position[2]);
  mesh.castShadow = false;
  mesh.receiveShadow = true;
  parent.add(mesh);
  return mesh;
}

function addPhotoGallery({ group, box }) {
  const assets = [album0Asset, album1Asset, album3Asset];
  const textures = assets.map((asset) => {
    const texture = new THREE.TextureLoader().load(asset);
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.anisotropy = 2;
    group.userData.disposeTextures.push(texture);
    return texture;
  });

  const addFrame = (index, x, z, side) => {
    const frame = new THREE.Group();
    frame.name = 'Observatory-Memory-PhotoFrame-' + index;
    frame.position.set(x, 1.68, z);
    frame.rotation.y = side < 0 ? Math.PI * 0.5 : -Math.PI * 0.5;
    group.add(frame);
    box('MemoryFrameBack-' + index, 0, 0, 0, 1.56, 1.92, 0.16, '#916f62', false, 0.18, frame);
    box('MemoryFrameTop-' + index, 0, 0.91, 0.105, 1.60, 0.13, 0.12, '#e7c68f', false, 0.26, frame);
    box('MemoryFrameBottom-' + index, 0, -0.91, 0.105, 1.60, 0.13, 0.12, '#e7c68f', false, 0.26, frame);
    box('MemoryFrameLeft-' + index, -0.735, 0, 0.105, 0.13, 1.76, 0.12, '#e7c68f', false, 0.26, frame);
    box('MemoryFrameRight-' + index, 0.735, 0, 0.105, 0.13, 1.76, 0.12, '#e7c68f', false, 0.26, frame);
    const photoMaterial = new THREE.MeshBasicMaterial({
      map: textures[index % textures.length],
      side: THREE.DoubleSide,
      toneMapped: false
    });
    const photo = addMesh(frame, new THREE.PlaneGeometry(1.34, 1.64), photoMaterial,
      'MemoryPhoto-' + index, [0, 0, 0.091]);
    photo.userData.albumDisplayOnly = true;
  };

  const placements = [
    [-6.2, -31.0, -1],
    [6.2, 32.0, 1],
    [-6.2, 99.0, -1]
  ];
  placements.forEach(([x, z, side], index) => addFrame(index, x, z, side));
}

function buildRunePuzzle({ group, box }) {
  const symbols = ['sun', 'moon', 'star'];
  const xPositions = [-2.8, 0, 2.8];
  const runes = [];
  const glyphMats = {
    sun: makeMat('#f4c56e', 0.28, 0.42, '#d99b35'),
    moon: makeMat('#92d7e8', 0.24, 0.42, '#4e9fbd'),
    star: makeMat('#c4a4ee', 0.24, 0.42, '#8b61ce')
  };

  box('SilentSymbols-CluePedestal', 0, 1.56, -22.2, 4.6, 2.25, 0.32, '#536a85', false, 0.24);
  const clueSequence = ['star', 'moon', 'sun'];
  clueSequence.forEach((symbol, index) => {
    const x = -1.35 + index * 1.35;
    const icon = symbol === 'sun'
      ? new THREE.SphereGeometry(0.22, 8, 6)
      : symbol === 'moon'
        ? new THREE.TorusGeometry(0.22, 0.075, 5, 12, Math.PI * 1.55)
        : new THREE.OctahedronGeometry(0.28, 0);
    addMesh(group, icon, glyphMats[symbol], 'SilentSymbols-Clue-' + symbol, [x, 1.65, -22.0]);
  });

  symbols.forEach((symbol, index) => {
    const x = xPositions[index];
    const root = new THREE.Group();
    root.name = 'SilentRune-' + symbol;
    root.position.set(x, FLOOR_Y + 0.04, -18.0);
    group.add(root);
    addMesh(root, new THREE.CylinderGeometry(0.56, 0.62, 0.11, 8), makeMat('#687f97', 0.28),
      'RuneBase-' + symbol, [0, 0, 0]);
    addMesh(root, new THREE.TorusGeometry(0.40, 0.035, 5, 18), glyphMats[symbol],
      'RuneHalo-' + symbol, [0, 0.08, 0]);
    let glyph;
    if (symbol === 'sun') glyph = new THREE.SphereGeometry(0.19, 8, 6);
    else if (symbol === 'moon') glyph = new THREE.TorusGeometry(0.20, 0.075, 5, 12, Math.PI * 1.55);
    else glyph = new THREE.OctahedronGeometry(0.25, 0);
    const glyphMesh = addMesh(root, glyph, glyphMats[symbol], 'RuneGlyph-' + symbol, [0, 0.16, 0]);
    if (symbol === 'moon') glyphMesh.rotation.z = -0.52;
    runes.push({ symbol, mesh: root, glyph: glyphMesh, solved: false, position: { x, z: -18.0 } });
  });
  return { runes, sequence: ['star', 'moon', 'sun'], index: 0 };
}

function buildMosaic({ group, box }) {
  box('MemoryMosaicTable', 0, 0.73, -3.0, 4.25, 0.16, 5.45, '#806d80', false, 0.16);
  box('MemoryMosaicRimFront', 0, 0.91, -5.68, 4.4, 0.18, 0.18, '#e3c18d', false, 0.28);
  box('MemoryMosaicRimBack', 0, 0.91, -0.32, 4.4, 0.18, 0.18, '#e3c18d', false, 0.28);
  box('MemoryMosaicRimLeft', -2.11, 0.91, -3.0, 0.18, 0.18, 5.3, '#e3c18d', false, 0.28);
  box('MemoryMosaicRimRight', 2.11, 0.91, -3.0, 0.18, 0.18, 5.3, '#e3c18d', false, 0.28);
  const guideTexture = new THREE.TextureLoader().load(album2Asset);
  guideTexture.colorSpace = THREE.SRGBColorSpace;
  guideTexture.anisotropy = 2;
  group.userData.disposeTextures.push(guideTexture);
  const guideMaterial = new THREE.MeshBasicMaterial({ map: guideTexture, side: THREE.DoubleSide });
  const guide = addMesh(group, new THREE.PlaneGeometry(1.75, 2.32), guideMaterial,
    'MemoryMosaic-FullImageGuide', [4.8, 1.62, -3.0]);
  guide.rotation.y = -Math.PI * 0.5;

  const cells = [];
  for (let row = 0; row < 4; row++) {
    for (let col = 0; col < 3; col++) {
      cells.push({ x: (col - 1) * 1.22, y: 1.01, z: -4.85 + row * 1.23 });
    }
  }
  const scramble = [7, 2, 9, 0, 10, 4, 6, 1, 11, 3, 8, 5];
  const sideMaterial = makeMat('#9b8da0', 0.12, 0.74);
  const topMaterials = [];
  const tiles = [];
  const tileGeometry = new THREE.BoxGeometry(1.12, 0.16, 1.12);
  scramble.forEach((pieceId, cellIndex) => {
    const topMaterial = makeMat('#b7a9b6', 0.08, 0.68);
    topMaterials.push(topMaterial);
    const materials = [sideMaterial, sideMaterial, topMaterial, sideMaterial, sideMaterial, sideMaterial];
    const mesh = addMesh(group, tileGeometry, materials, 'MemoryMosaic-Cube-' + pieceId,
      [cells[cellIndex].x, cells[cellIndex].y, cells[cellIndex].z]);
    mesh.userData.pieceId = pieceId;
    mesh.userData.cellIndex = cellIndex;
    mesh.userData.mosaicTile = true;
    tiles.push({ mesh, pieceId, cellIndex });
  });
  const selectionRing = addMesh(group, new THREE.TorusGeometry(0.56, 0.045, 5, 18),
    makeMat('#fff0a6', 0.22, 0.36, '#e3bd58'), 'MemoryMosaic-SelectionRing', [0, 1.12, 0]);
  selectionRing.rotation.x = Math.PI / 2;
  selectionRing.visible = false;

  const albumTexture = new THREE.TextureLoader().load(album2Asset, (texture) => {
    if (group.userData.disposed) {
      texture.dispose();
      return;
    }
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.anisotropy = 2;
    for (const tile of tiles) {
      const row = Math.floor(tile.pieceId / 3);
      const col = tile.pieceId % 3;
      const crop = texture.clone();
      crop.colorSpace = THREE.SRGBColorSpace;
      crop.repeat.set(1 / 3, 1 / 4);
      crop.offset.set(col / 3, (3 - row) / 4);
      crop.needsUpdate = true;
      group.userData.disposeTextures.push(crop);
      const topMaterial = tile.mesh.material[2];
      topMaterial.map = crop;
      topMaterial.color.set('#ffffff');
      topMaterial.needsUpdate = true;
    }
  });
  group.userData.disposeTextures.push(albumTexture);

  return {
    tiles,
    cells,
    selectionRing,
    selectedTile: null,
    swapAnimation: null,
    isSolved: false
  };
}

function buildWeightPuzzle({ group, box, solids }) {
  const cratePositions = [
    { x: -4.1, z: 9.7 },
    { x: 0, z: 9.2 },
    { x: 4.1, z: 9.7 }
  ];
  const targets = [
    { x: -4.1, z: 15.0 },
    { x: 0, z: 15.5 },
    { x: 4.1, z: 15.0 }
  ];
  const targetMeshes = [];
  targets.forEach((target, index) => {
    const ring = addMesh(group, new THREE.TorusGeometry(0.58, 0.055, 5, 18),
      makeMat('#f2d18c', 0.28, 0.4, '#c28c43'),
      'WeightTruth-Target-' + index, [target.x, FLOOR_Y + 0.07, target.z]);
    ring.rotation.x = Math.PI / 2;
    targetMeshes.push(ring);
    box('WeightTruth-Plate-' + index, target.x, FLOOR_Y + 0.04, target.z,
      1.0, 0.08, 1.0, '#927c66', false, 0.14);
  });

  const crates = [];
  cratePositions.forEach((position, index) => {
    const root = new THREE.Group();
    root.name = 'WeightTruth-Crate-' + index;
    root.position.set(position.x, FLOOR_Y + 0.43, position.z);
    group.add(root);
    box('WeightCrateCore-' + index, 0, 0, 0, 0.78, 0.78, 0.78, '#ad7950', false, 0.05, root);
    for (const y of [-0.27, 0, 0.27]) {
      box('WeightCrateRail-' + index + '-' + y, 0, y, -0.405, 0.80, 0.075, 0.055, '#e0b77e', false, 0.08, root);
    }
    const prop = {
      id: 'level5-weight-crate-' + index,
      group: root,
      origin: { x: position.x, y: FLOOR_Y + 0.43, z: position.z },
      spawnLift: 0,
      mass: 7.5,
      gravityScale: 1,
      linearDamping: 0.62,
      angularDamping: 2.2,
      friction: 0.88,
      restitution: 0.025,
      ccdEnabled: true,
      canSleep: false
    };
    solids.push({
      x: position.x, y: FLOOR_Y + 0.43, z: position.z,
      sx: 0.39, sy: 0.39, sz: 0.39,
      dynamicProp: prop
    });
    crates.push({ id: prop.id, target });
  });
  return { crates, targets, targetMeshes, completed: false };
}

function buildLightPuzzle({ group, box }) {
  const positions = [-3.2, 0, 3.2];
  const targetSteps = [1, 3, 2];
  const mirrors = positions.map((x, index) => {
    box('LightWeaver-Base-' + index, x, FLOOR_Y + 0.20, 31.0, 1.20, 0.34, 1.20,
      '#4f8588', false, 0.18);
    const root = new THREE.Group();
    root.name = 'LightWeaver-Prism-' + index;
    root.position.set(x, FLOOR_Y + 1.05, 31.0);
    group.add(root);
    const crystal = addMesh(root, new THREE.OctahedronGeometry(0.42, 0),
      makeMat('#8de6e0', 0.22, 0.3, '#46c5c0'),
      'LightWeaver-Crystal-' + index, [0, 0, 0]);
    const mirror = addMesh(root, new THREE.BoxGeometry(0.84, 0.075, 0.13),
      makeMat('#e7efff', 0.54, 0.22, '#9bc8ff'),
      'LightWeaver-Mirror-' + index, [0, -0.42, 0]);
    const halo = addMesh(root, new THREE.TorusGeometry(0.58, 0.035, 5, 20),
      makeMat('#a9f5ef', 0.16, 0.38, '#61d7cf'),
      'LightWeaver-Halo-' + index, [0, -0.12, 0]);
    halo.rotation.x = Math.PI / 2;
    const state = { index, root, crystal, mirror, step: 0, targetStep: targetSteps[index] };
    const targetAngle = state.targetStep * Math.PI * 0.5;
    const pointer = addMesh(group, new THREE.ConeGeometry(0.11, 0.32, 4),
      makeMat('#f4dfaa', 0.22, 0.4), 'LightWeaver-TargetPointer-' + index,
      [x + Math.sin(targetAngle) * 0.72, FLOOR_Y + 1.05,
        31.0 + Math.cos(targetAngle) * 0.72]);
    pointer.rotation.set(Math.PI * 0.5, targetAngle, 0);
    state.pointer = pointer;
    state.ray = addMesh(root, new THREE.BoxGeometry(0.075, 0.075, 0.88),
      new THREE.MeshBasicMaterial({ color: '#a4fff0', transparent: true, opacity: 0.68 }),
      'LightWeaver-ReflectedRay-' + index, [0, -0.18, 0.58]);
    return state;
  });
  box('LightWeaver-Emitter', 0, FLOOR_Y + 1.15, 25.8, 0.45, 1.0, 0.45, '#f5e2a6', false, 0.22);
  box('LightWeaver-Receiver', 0, FLOOR_Y + 1.18, 36.0, 1.2, 1.1, 0.35, '#d8f8ed', false, 0.22);
  const beam = addMesh(group, new THREE.CylinderGeometry(0.045, 0.045, 10.0, 6),
    new THREE.MeshBasicMaterial({ color: '#a4fff0', transparent: true, opacity: 0.44 }),
    'LightWeaver-Beam', [0, FLOOR_Y + 1.2, 31.0]);
  beam.rotation.x = Math.PI / 2;
  return { mirrors, targetSteps, complete: false };
}

function addGear(root, index, x) {
  const gear = new THREE.Group();
  gear.name = 'Clockwork-InteractiveGear-' + index;
  gear.position.set(x, FLOOR_Y + 1.05, 49.0);
  root.add(gear);
  const ring = addMesh(gear, new THREE.TorusGeometry(0.66, 0.15, 5, 12),
    makeMat('#d7bc8e', 0.56, 0.42, '#9b7742'), 'ClockworkGearRing-' + index);
  ring.rotation.x = Math.PI / 2;
  for (let tooth = 0; tooth < 8; tooth++) {
    const angle = tooth * Math.PI / 4;
    const toothMesh = addMesh(gear, new THREE.BoxGeometry(0.20, 0.19, 0.28),
      makeMat('#b69b73', 0.55, 0.46), 'ClockworkGearTooth-' + index + '-' + tooth,
      [Math.cos(angle) * 0.77, 0, Math.sin(angle) * 0.77]);
    toothMesh.rotation.y = -angle;
  }
  addMesh(gear, new THREE.CylinderGeometry(0.24, 0.24, 0.24, 8),
    makeMat('#f0d7a1', 0.6, 0.32), 'ClockworkGearHub-' + index);
  addMesh(gear, new THREE.BoxGeometry(0.10, 0.10, 0.98),
    makeMat('#fff0b8', 0.32, 0.34, '#d6b45e'),
    'ClockworkGearDirectionNeedle-' + index, [0, 0.12, 0.52]);
  return gear;
}

function buildClockPuzzle({ group, box }) {
  const targetSteps = [2, 1, 3];
  const gears = [-3.2, 0, 3.2].map((x, index) => {
    box('Clockwork-GearPedestal-' + index, x, FLOOR_Y + 0.18, 49.0,
      1.85, 0.28, 1.85, '#6c6885', false, 0.24);
    const root = addGear(group, index, x);
    const targetAngle = targetSteps[index] * Math.PI * 0.5;
    const marker = addMesh(group, new THREE.ConeGeometry(0.13, 0.30, 4),
      makeMat('#fff0b8', 0.28, 0.32, '#edc86b'),
      'Clockwork-GearTarget-' + index,
      [x + Math.sin(targetAngle) * 1.0, FLOOR_Y + 1.05,
        49.0 + Math.cos(targetAngle) * 1.0]);
    marker.rotation.set(Math.PI * 0.5, targetAngle, 0);
    return { index, root, step: 0, targetStep: targetSteps[index], marker };
  });
  box('Clockwork-PendulumTop', 0, 3.45, 45.9, 4.8, 0.22, 0.28, '#d9c18e', false, 0.26);
  const pendulum = new THREE.Group();
  pendulum.name = 'Clockwork-PendulumPivot';
  pendulum.position.set(0, 3.34, 45.9);
  group.add(pendulum);
  addMesh(pendulum, new THREE.CylinderGeometry(0.055, 0.055, 2.6, 6),
    makeMat('#d6c18e', 0.62), 'Clockwork-PendulumRod', [0, -1.25, 0]);
  addMesh(pendulum, new THREE.SphereGeometry(0.42, 8, 6),
    makeMat('#edcb89', 0.52), 'Clockwork-PendulumWeight', [0, -2.52, 0]);
  return { gears, targetSteps, pendulum, complete: false, elapsed: 0 };
}

function makeArtifact(kind) {
  const root = new THREE.Group();
  root.name = 'PrincessArtifact-' + kind;
  const gold = makeMat('#e7c77e', 0.68, 0.28, '#a47b35');
  const silver = makeMat('#dce6e8', 0.68, 0.3);
  const gem = makeMat('#a77ee8', 0.28, 0.22, '#754bc0');
  if (kind === 'ring') {
    const band = addMesh(root, new THREE.TorusGeometry(0.31, 0.075, 6, 18), gold, 'PrincessRingBand');
    band.rotation.x = Math.PI / 2;
    addMesh(root, new THREE.OctahedronGeometry(0.17, 0), gem, 'PrincessRingGem', [0, 0.28, 0]);
  } else if (kind === 'crown') {
    const base = addMesh(root, new THREE.TorusGeometry(0.42, 0.09, 6, 18), gold, 'PrincessCrownBase');
    base.rotation.x = Math.PI / 2;
    for (let i = 0; i < 5; i++) {
      const angle = (i / 5) * Math.PI * 2;
      addMesh(root, new THREE.ConeGeometry(0.09, 0.46, 4), gold,
        'PrincessCrownPeak-' + i, [Math.cos(angle) * 0.38, 0.25, Math.sin(angle) * 0.38]);
    }
    addMesh(root, new THREE.OctahedronGeometry(0.16, 0), gem, 'PrincessCrownGem', [0, 0.50, 0]);
  } else if (kind === 'scepter') {
    const rod = addMesh(root, new THREE.CylinderGeometry(0.065, 0.085, 1.05, 6), gold,
      'PrincessScepterRod', [0, 0.48, 0]);
    rod.rotation.z = -0.08;
    addMesh(root, new THREE.OctahedronGeometry(0.24, 0), gem,
      'PrincessScepterGem', [0, 1.08, 0]);
  } else if (kind === 'armor') {
    addMesh(root, new THREE.CylinderGeometry(0.48, 0.62, 0.82, 6, 1),
      silver, 'PrincessRoyalArmorPlate', [0, 0.42, 0]);
    addMesh(root, new THREE.BoxGeometry(0.26, 0.52, 0.20), gold,
      'PrincessArmorCenterTrim', [0, 0.42, 0.31]);
    addMesh(root, new THREE.OctahedronGeometry(0.16, 0), gem,
      'PrincessArmorGem', [0, 0.65, 0.38]);
  }
  return root;
}

