    const returnZ=level.id===5?-44.0:wide?-33:-9.95, frontZ=level.id===5?182.0:level.id===4?46.2:wide?34.45:10.55;
    const tileDepth=level.id===5?236:level.id===4?88.2:wide?66.2:20.3;
    box('ArenaFloor-'+level.id,0,0.06,arenaCenterZ,floorWidth,0.035,floorDepth,level.color,false);
    if(!parkourCourse||wide)solids.push({x:0,y:-0.02,z:arenaCenterZ,sx:floorWidth*0.5,sy:0.02,sz:floorDepth*0.5});
    const tileExtent=level.id===5?8:wide?27:9;
    for(let x=-tileExtent;x<=tileExtent;x+=3)box('ArenaTile-'+x,x,0.081,arenaCenterZ,0.035,0.008,tileDepth,x%2?level.bright:'#fff0df',false);
    box('ArenaWallLeft',-halfWidth,1.42,arenaCenterZ,0.25,2.85,floorDepth,'#514c60');
    box('ArenaWallRight',halfWidth,1.42,arenaCenterZ,0.25,2.85,floorDepth,'#514c60');
    box('ArenaWallFront',0,1.42,frontZ,floorWidth+0.1,2.85,0.25,'#514c60');
    const portalHalf=wide?3.25:2.45, wallWidth=halfWidth-portalHalf, wallX=(halfWidth+portalHalf)*0.5;
    box('ArenaBackWallLeft',-wallX,1.42,returnZ,wallWidth,2.85,0.25,'#514c60');
    box('ArenaBackWallRight',wallX,1.42,returnZ,wallWidth,2.85,0.25,'#514c60');
    box('ReturnPostL',-1.05,1.05,returnZ,0.16,2.05,0.16,level.bright,false,0.18);
    box('ReturnPostR',1.05,1.05,returnZ,0.16,2.05,0.16,level.bright,false,0.18);
    box('ReturnLintel',0,2.08,returnZ,2.25,0.16,0.16,level.bright,false,0.18);
    const finish=parkourCourse?.platforms.find(p=>p.finish);
    const goalZ=finish?finish.z-0.18:wide?27.35:8.55, goalY=finish?finish.top-0.0775:0;
    box('GoalPostL',level.itemX-0.8,goalY+0.82,goalZ,0.14,1.55,0.14,level.bright,false,0.16);
    box('GoalPostR',level.itemX+0.8,goalY+0.82,goalZ,0.14,1.55,0.14,level.bright,false,0.16);
    box('GoalTop',level.itemX,goalY+1.62,goalZ,1.75,0.14,0.14,level.bright,false,0.16);

    if(parkourCourse){
      if(level.id===1)box('MossBog',0.25,0.088,2,10.8,0.012,14.8,'#315d5a',false,0.04);
      if(level.id===2)box('SkyMist',0.25,0.105,2,10.8,0.018,14.8,'#356e88',false,0.02);
      const choiceStates = new Map();
      for(const platform of parkourCourse.platforms){
