          const motion={
            axis:motionAxis,
            baseX:platform.x,baseZ:platform.z,
            range:motionRange,
            speed:motionSpeed,
            phase:motionPhase,
            top:platform.top,width:platform.width,spanZ:platform.depth,
            elapsed:0,riderGrace:0,
            previousRenderX:initialX,previousRenderZ:initialZ,
            currentRenderX:initialX,currentRenderZ:initialZ,
            choiceState,
            choiceSide:platform.choiceSide||0,
            choiceMesh:choiceState?deckMesh:null,
            choiceEnabled:choiceState?false:null,
            temporary:platform.temporary===true
          };
          board.userData.boardMotion=motion;
          const prop={
            id:'level'+level.id+'-moving-platform-'+platform.name,
            group:board,origin,spawnLift:0,isStatic:platform.memoryBlock === true,mass:80,gravityScale:0,
            linearDamping:0,angularDamping:0,friction:platform.slippery?(platform.friction??0.04):0.9,
