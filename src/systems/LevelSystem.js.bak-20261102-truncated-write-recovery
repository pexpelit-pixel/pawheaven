  updateArena(dt) {
    const position = this.game.dog?.group?.position;
    const level = this.activeLevel;
    if (!position || !level) return;

    const course = PARKOUR_COURSES[level.id] || null;
    const stepDt = Math.min(0.05, Math.max(0, Number(dt) || 0));
    this.elapsed += stepDt;
    this.syncBoardRiders(position);
    // Only the explicitly marked Observatory X ice boards reduce ground traction.
    // Reset every frame first so the effect cannot leak into the warm-up or shelter.
    if (this.game.movement) {
      let surfaceTraction = 1;
      if (level.id === 5 && this.game.movement.grounded) {
        for (const platform of course?.platforms || []) {
          if (platform.slippery !== true) continue;
          const onBoard = Math.abs(position.x - platform.x) <= platform.width * 0.5 + 0.08
            && Math.abs(position.z - platform.z) <= platform.depth * 0.5 + 0.08
            && Math.abs(position.y - platform.top) <= 0.30;
          if (onBoard) {
            surfaceTraction = 0.20;
            break;
          }
        }
      }
      this.game.movement.surfaceTraction = surfaceTraction;
    }

    if (this.questObject) {
      const finish = course?.platforms.find((platform) => platform.finish);
      this.questObject.rotation.y += stepDt * 0.9;
      this.questObject.position.y = (finish ? finish.top + 0.48 : 0.52)
        + Math.sin(this.elapsed * 2.8) * 0.06;
      this.questObject.children[0]?.rotation.set(
        this.elapsed * 0.3,
        this.elapsed * 0.7,
        this.elapsed * 0.2
      );
    }
    if (this.animatedMechanic) {
      this.animatedMechanic.rotation.y += stepDt
        * (level.id === 1 ? 3.5 : level.id === 2 ? 2.8 : level.id === 5 ? 0.85 : 0.42);
    }
    if (this.animatedMechanic2) this.animatedMechanic2.rotation.y -= stepDt * 2.35;

    // The shelter return portal is independent from the finish pressure plate.
    const returnZ = level.id === 5 ? -44.0 : level.id === 4 ? -32.8 : level.id === 3 ? -32.4 : -9.5;
    if (Math.hypot(position.x, position.z - returnZ) < (level.id === 3 || level.id === 4 || level.id === 5 ? 1.0 : 0.88)) {
      this.returnHome(false);
      return;
    }

    // Respawn only when K-09 is actually grounded below the parkour route.
    if (course && this.game.movement?.grounded && position.y <= 0.18) {
      const inFallZone = level.id === 5
        ? position.z > -43.0 && position.z < 180.1
        : level.id === 4
          ? position.z > -31.5 && position.z < 45.2
          : level.id === 3
            ? position.z > -31.5 && position.z < 31.0
            : position.z > -9.35 && position.z < 9.8;
      if (inFallZone) {
        const safe = course.platforms.some((platform) =>
          Math.abs(position.x - platform.x) <= platform.width * 0.5 - 0.06
          && Math.abs(position.z - platform.z) <= platform.depth * 0.5 - 0.06
          && Math.abs(position.y - platform.top) <= 0.22
        );
        if (!safe) {
          this.moveDogTo(this.parkourRespawnPoint || course.spawn, this.activePhysics);
          this.game.resetRenderPositionSnapshots?.();
          this.setPrompt('K-09 jatuh! Kembali ke checkpoint terakhir. Coba lagi.');
          return;
        }
      }
    }

    // Update a special mechanic, but do not let it stop checkpoint or finish processing.
    // Its return value only means that its own objective is still active.
    const mechanicBusy = this.updateSpecialMechanic(level, position, stepDt);
    const plate = this.activeArena?.userData?.finishPressurePlate;
    let objectivesReady = false;

    if (plate) {
      const point = plate.userData.finishPoint || {
        x: plate.position.x,
        y: plate.position.y,
        z: plate.position.z
      };
      const zone = plate.userData.zone || {};
      const zoneX = Number.isFinite(zone.x) ? zone.x : point.x;
      const zoneZ = Number.isFinite(zone.z) ? zone.z : point.z;
      const finishPlatform = course?.platforms.find((platform) => platform.finish);
      // Use the full finish deck plus K-09's footprint, not a narrow centre-only point.
      // For puzzle arenas, include the visible plate and the chassis/paw reach.
      const zoneRX = Math.max(
        Number.isFinite(zone.rx) ? zone.rx : 1.05,
        finishPlatform ? finishPlatform.width * 0.5 + 0.34 : 1.28
      );
      const zoneRZ = Math.max(
        Number.isFinite(zone.rz) ? zone.rz : 0.95,
        finishPlatform ? finishPlatform.depth * 0.5 + 0.34 : 1.08
      );

      const requireCheckpoints = level.finishRequirements?.checkpoints !== false;
      const requireMechanic = level.finishRequirements?.mechanic === true;
      const checkpointsReady = !requireCheckpoints
        || this.checkpointIndex >= this.checkpointGroups.length;
      const mechanicReady = !requireMechanic || this.special?.completed === true;
      objectivesReady = checkpointsReady && mechanicReady;

      const heightDelta = Math.abs(position.y - point.y);
      const verticalVelocity = Number(
        this.game.movement?.verticalVelocity
        ?? this.game.dog?.verticalVelocity
        ?? 0
      );
      const grounded = this.game.movement?.grounded === true
        || this.game.dog?.grounded === true;
      const footContacts = this.game.dog?.footContacts || [];
      const footSupportedAtFinish = footContacts.some((contact) =>
        contact?.hasSurface === true
        && contact.blocked !== true
        && Number.isFinite(contact.currentY)
        && Math.abs(contact.currentY - point.y) <= 0.48
      );
      const stable = grounded || footSupportedAtFinish
        || (heightDelta <= 0.24 && Math.abs(verticalVelocity) <= 0.55);
      const inside = Math.abs(position.x - zoneX) <= zoneRX
        && Math.abs(position.z - zoneZ) <= zoneRZ;
      const surfaceTolerance = course ? 1.05 : 0.88;
      const pressed = inside && stable && heightDelta <= surfaceTolerance;
      const activating = pressed && objectivesReady;

      plate.userData.pressed = pressed;
      plate.userData.ready = objectivesReady;
      plate.userData.inside = inside;
      plate.userData.grounded = stable;
      plate.userData.heightDelta = heightDelta;
      plate.userData.blockReason = !checkpointsReady
        ? 'checkpoint'
        : !mechanicReady ? 'mechanic' : !inside ? 'position' : !stable ? 'grounded' : null;

      if (inside && !objectivesReady) {
        const lockMessage = !checkpointsReady
          ? 'FINISH terkunci: aktifkan checkpoint ' + Math.min(this.checkpointIndex + 1, this.checkpointGroups.length)
            + '/' + this.checkpointGroups.length + ' terlebih dahulu.'
          : 'FINISH terkunci: selesaikan mekanik utama Level ' + level.id + ' terlebih dahulu.';
        this.setPrompt(lockMessage);
      } else if (inside && objectivesReady && !stable) {
        this.setPrompt('Mendarat dan diam sejenak di PRESSURE PLATE untuk menyelesaikan Level ' + level.id + '.');
      }

      // Require a continuous press. Walking away or jumping off cancels the timer.
      if (activating) {
        if (!plate.userData.pendingActivation) {
          plate.userData.pendingActivation = true;
          plate.userData.pressElapsed = 0;
        }
        plate.userData.pressElapsed = Math.min(
          0.25,
          (plate.userData.pressElapsed || 0) + stepDt
        );
      } else {
        plate.userData.pendingActivation = false;
        plate.userData.pressElapsed = 0;
      }

      const visualPressed = activating && plate.userData.pendingActivation === true;
      if (plate.userData.plate) {
        const targetY = visualPressed
          ? plate.userData.platePressedY
          : plate.userData.plateRestY;
        plate.userData.plate.position.y = THREE.MathUtils.damp(
          plate.userData.plate.position.y,
          targetY,
          visualPressed ? 32 : 18,
          stepDt
        );
      }

      const visualState = (objectivesReady ? 'ready' : 'locked')
        + (visualPressed ? '-pressed' : '-rest');
      if (plate.userData.visualState !== visualState) {
        plate.userData.visualState = visualState;
        const mat = plate.userData.plateMaterial;
        if (mat) {
          mat.color.set(visualPressed ? '#fff4b5' : objectivesReady ? level.bright : '#7193a2');
          mat.emissive.set(visualPressed ? '#e4b94e' : objectivesReady ? level.color : '#2b5366');
          mat.emissiveIntensity = visualPressed ? 1.1 : objectivesReady ? 0.32 : 0.16;
        }
        for (const led of plate.userData.statusLeds || []) {
          led.material.color.set(visualPressed ? '#fff8d4' : objectivesReady ? '#ffe99a' : '#7193a2');
          led.material.emissive.set(visualPressed ? '#ffdf65' : objectivesReady ? '#b58d37' : '#2b5366');
          led.material.emissiveIntensity = visualPressed ? 1.5 : objectivesReady ? 0.72 : 0.22;
        }
      }

      if (plate.userData.pendingActivation
        && plate.userData.pressElapsed >= 0.12
        && !this.finishTriggerLatched) {
        this.finishTriggerLatched = true;
        if (this.completeLevel(level)) return;
        this.finishTriggerLatched = false;
        plate.userData.pendingActivation = false;
        plate.userData.pressElapsed = 0;
      }
    }

    // Checkpoints remain usable while a special objective is active. This prevents
    // the mechanic update loop from starving the rest of the Level state machine.
    if (this.checkpointIndex < this.checkpointGroups.length) {
      const marker = this.checkpointGroups[this.checkpointIndex];
      const target = marker?.userData?.point;
      if (!target) return;

      const checkpointDistance = Math.hypot(
        position.x - target.x,
        position.z - target.z
      );
      const checkpointHeightReady = ![4, 5].includes(level.id)
        || !Number.isFinite(target.y)
        || Math.abs(position.y - target.y) <= 0.62;
      if (checkpointDistance >= 1.30 || !checkpointHeightReady) {
        if (!mechanicBusy) {
          this.setPrompt(
            checkpointDistance < 1.30 && !checkpointHeightReady
              ? 'Naik ke platform ' + (level.checkpointLabel || 'checkpoint') + ' ' + (this.checkpointIndex + 1) + ' untuk mengaktifkannya.'
              : 'Level ' + level.id + ': dekati '
                + (level.checkpointLabel || 'checkpoint') + ' '
                + (this.checkpointIndex + 1) + '/' + this.checkpointGroups.length + '.'
          );
        }
        return;
      }

      // Checkpoints activate on grounded contact. Requiring an extra INTERACT press
      // made the finish feel broken when players had physically crossed the beacon.
      const checkpointGrounded = this.game.movement?.grounded === true
        || this.game.dog?.grounded === true
        || (this.game.dog?.footContacts || []).some((contact) =>
          contact?.hasSurface === true && contact.blocked !== true
        );
      if (!checkpointGrounded) {
        this.setPrompt('Mendarat di ' + (level.checkpointLabel || 'checkpoint') + ' untuk mengaktifkannya.');
        return;
      }

      marker.visible = false;
      this.checkpointIndex += 1;
      if (course && Number.isFinite(target.y)) {
        this.parkourRespawnPoint = {
          x: target.x,
          y: target.y + 0.025,
          z: target.z,
          yaw: Math.PI
        };
      }

      const next = this.checkpointGroups[this.checkpointIndex];
      if (next) next.visible = true;
      else if (this.questObject && !course) this.questObject.visible = true;

      this.setPrompt(this.checkpointIndex < this.checkpointGroups.length
        ? 'Checkpoint ' + this.checkpointIndex + '/' + this.checkpointGroups.length
          + ' aktif. Lanjut ke beacon berikutnya.'
        : 'Semua checkpoint aktif! Injak PRESSURE PLATE di FINISH.');
      return;
    }

    // Keep the mechanic's current instruction visible while it is still incomplete.
    if (mechanicBusy && !objectivesReady) return;

    this.setPrompt(objectivesReady
      ? 'Semua objektif selesai. Injak PRESSURE PLATE di FINISH untuk mengakhiri Level ' + level.id + '.'
      : 'Selesaikan mekanik utama level sebelum menuju FINISH.');
  }
  completeLevel(level) {
    if (!level || this.transitioning || this.activeLevel?.id !== level.id) return false;
    const granted = this.game.inventory?.grantQuestItem?.(level.token) ?? false;
    const reward = level.reward || { pawTokens: 0, badge: 'Explorer' };
    const firstReward = !this.rewarded.has(level.id);
    let recoveredLegacyLevelTwoReward = false;

    if (firstReward) {
      this.pawTokens += reward.pawTokens || 0;
      this.rewarded.add(level.id);
      if (reward.badge) this.unlockedBadges.add(reward.badge);
      if (reward.unlock) this.unlockedRewards.add(reward.unlock);
    }
    if (level.id === 2 && !this.parkourLevel2RewardRecoveryApplied) {
      if (!firstReward) {
        this.pawTokens += reward.pawTokens || 0;
        if (reward.badge) this.unlockedBadges.add(reward.badge);
        if (reward.unlock) this.unlockedRewards.add(reward.unlock);
        recoveredLegacyLevelTwoReward = true;
      }
      this.parkourLevel2RewardRecoveryApplied = true;
    }
    let bonus = 0;
    if (level.id === 1 && !this.parkourBonusV2Applied) {
      if (!firstReward) { bonus = 25; this.pawTokens += bonus; }
      this.parkourBonusV2Applied = true;
    }
    if (level.id === 2 && !this.parkourLevel2BonusApplied) {
      if (!firstReward && !recoveredLegacyLevelTwoReward) { bonus = 75; this.pawTokens += bonus; }
      this.parkourLevel2BonusApplied = true;
    }

    this.game.pawTokens = this.pawTokens;
    this.game.levelBadges = [...this.unlockedBadges];
    this.game.levelUnlocks = [...this.unlockedRewards];
    this.updateRewardHUD();
    this.completed.add(level.id);
    this.saveProgress();
    this.refreshGate();
    this.refreshGiftRequirement();

    const rewardText = recoveredLegacyLevelTwoReward
      ? 'Pemulihan hadiah +' + (reward.pawTokens || 0) + ' Paw Tokens, lencana ' + reward.badge + ' dan unlock ' + (reward.unlock || 'Explorer') + '.'
      : firstReward
        ? 'Hadiah +' + (reward.pawTokens || 0) + ' Paw Tokens, lencana ' + reward.badge + ' dan unlock ' + (reward.unlock || 'Explorer') + '.'
        : bonus > 0
          ? 'Bonus selisih hadiah +' + bonus + ' Paw Tokens.'
          : 'Lencana ' + reward.badge + ' sudah pernah diperoleh.';
    this.lastRewardMessage = 'Misi Level ' + level.id + ' selesai! ' + rewardText
      + (granted ? '' : ' Tas penuh, tetapi progres dan hadiah tetap dicatat.')
      + ' Saldo: ' + this.pawTokens + ' Paw Tokens. K-09 kembali ke shelter.';
    this.returnHome(true);
    this.setPrompt(this.lastRewardMessage);
    return true;
  }

  preparePhysics(dt) {
    if (this.transitioning || ![3, 4, 5].includes(this.activeLevel?.id)) return;
    const records = this.activePhysics?.dynamicProps || [];
    const dogPosition = this.game.dog?.group?.position;
    if (!dogPosition) return;
    const step = Math.min(0.05, Math.max(0, Number(dt) || 0));
    const motionTick = (this.platformMotionTick || 0) + 1;
    this.platformMotionTick = motionTick;
    const movement = this.game.movement;
    let ridingPlatform = false;

    const chooseSide = (state) => {
      let side = Math.random() < 0.5 ? -1 : 1;
      if (side === state.lastSide && Math.random() < 0.35) side = -side;
      return side;
    };

    for (const record of records) {
      if (!record.body) continue;
      const motion = record.group?.userData?.boardMotion;
      const spin = record.group?.userData?.spinMotion;
      const lift = record.group?.userData?.liftMotion;

      if (motion) {
        const state = motion.choiceState;
        if (state && state.lastUpdatedTick !== motionTick) {
          state.lastUpdatedTick = motionTick;
          const distanceToTrigger = Math.hypot(
            dogPosition.x - state.trigger.x,
            dogPosition.z - state.trigger.z
          );

          if (!state.started && distanceToTrigger <= state.radius) {
            state.started = true;
            state.activeSide = chooseSide(state);
            state.remaining = state.duration;
          } else if (state.started) {
            state.remaining = Math.max(0, state.remaining - step);
            if (state.remaining <= 0) {
              if (state.activeSide !== null) {
                state.lastSide = state.activeSide;
                state.activeSide = null;
                state.remaining = state.cooldown;
              } else {
                state.activeSide = chooseSide(state);
                state.remaining = state.duration;
              }
            }
          }
        }

        if (state) {
          const enabled = state.activeSide === motion.choiceSide;
          if (motion.choiceEnabled !== enabled) setTimedChoiceBoardEnabled(record, enabled);
        }

        const previousX = motion.currentRenderX ?? motion.baseX;
        const previousZ = motion.currentRenderZ ?? motion.baseZ;
        motion.previousRenderX = previousX;
        motion.previousRenderZ = previousZ;
        motion.elapsed = (motion.elapsed || 0) + step;
        const offset = Math.sin(motion.elapsed * motion.speed + motion.phase) * motion.range;
        motion.currentRenderX = motion.baseX + (motion.axis === 'x' ? offset : 0);
        motion.currentRenderZ = motion.baseZ + (motion.axis === 'z' ? offset : 0);
        const dx = motion.currentRenderX - previousX;
        const dz = motion.currentRenderZ - previousZ;

        const footSupported = (this.game.dog?.footContacts || []).some((contact) =>
          contact?.hasSurface === true
          && contact.blocked !== true
          && Number.isFinite(contact.currentY)
          && Math.abs(contact.currentY - motion.top) <= 0.28
        );
        const boardActive = !state || state.activeSide === motion.choiceSide;
        const withinBoard = Math.abs(dogPosition.x - previousX) <= motion.width * 0.5 + 0.20
          && Math.abs(dogPosition.z - previousZ) <= motion.spanZ * 0.5 + 0.20;
        const nearBoardTop = Math.abs(dogPosition.y - motion.top) <= 0.30;
        const supportNow = movement?.grounded === true || footSupported;

        // Foot probes are sampled less often than the 60 Hz physics loop. Keep a
        // very short support grace so one missed foot ray cannot drop the carry
        // for a single tick and make the moving collider feel like it catches K-09.
        motion.riderGrace = supportNow && withinBoard && nearBoardTop && boardActive
          ? 0.10
          : Math.max(0, (motion.riderGrace || 0) - step);
        const rider = boardActive && withinBoard && nearBoardTop
          && (supportNow || motion.riderGrace > 0);

        // CharacterController casts run before world.step(). Move the Level 5
        // kinematic collider to the exact pose for this fixed tick now, instead of
        // leaving its shape at the previous pose until after K-09's cast. K-09 is
        // carried by the same delta below, so both contact queries use one pose.
        const nextBoardPose = {
          x: motion.currentRenderX,
          y: record.prop.origin.y,
          z: motion.currentRenderZ
        };
        if (this.activeLevel?.id === 5) {
          record.body.setTranslation(nextBoardPose, true);
          record.body.setNextKinematicTranslation(nextBoardPose);
        } else {
          record.body.setNextKinematicTranslation(nextBoardPose);
        }

        if (rider) {
          ridingPlatform = true;
          dogPosition.x += dx;
          dogPosition.z += dz;
          this.activePhysics.setPosition({
            x: dogPosition.x,
            y: dogPosition.y + 0.78,
            z: dogPosition.z
          });
          if (movement?.platformCarryVelocity) {
            movement.platformCarryVelocity.x = step > 1e-5 ? THREE.MathUtils.clamp(dx / step, -2.4, 2.4) : 0;
            movement.platformCarryVelocity.z = step > 1e-5 ? THREE.MathUtils.clamp(dz / step, -2.4, 2.4) : 0;
          }
        }
      }

      if (spin) {
        spin.previousAngle = spin.currentAngle;
        spin.elapsed = (spin.elapsed || 0) + step;
        spin.currentAngle = spin.phase + spin.elapsed * spin.speed;
        const half = spin.currentAngle * 0.5;
        record.body.setNextKinematicRotation({
          x: 0,
          y: Math.sin(half),
          z: 0,
          w: Math.cos(half)
        });
      }

      if (lift) {
        // Elevator architecture: one deterministic pre-physics kinematic motor.
        // Rapier receives the next platform pose before Movement queries contacts,
        // while the rider receives the same delta before its character-controller move.
        const previousY = Number.isFinite(lift.currentY) ? lift.currentY : lift.baseY;
        const previousTop = previousY + lift.halfHeight;
        const width = Number.isFinite(lift.width) ? lift.width : 3.85;
        const depth = Number.isFinite(lift.depth) ? lift.depth : 3.30;
        const withinLift = Math.abs(dogPosition.x - lift.x) <= width * 0.5 + 0.16
          && Math.abs(dogPosition.z - lift.z) <= depth * 0.5 + 0.16;
        const heightAboveDeck = dogPosition.y - previousTop;
        const verticalSpeed = Number.isFinite(movement?.verticalVelocity)
          ? movement.verticalVelocity
          : Number(this.game.dog?.verticalVelocity) || 0;
        const footSupported = (this.game.dog?.footContacts || []).some((contact) =>
          contact?.hasSurface === true
          && contact.blocked !== true
          && Number.isFinite(contact.currentY)
          && Math.abs(contact.currentY - previousTop) <= 0.48
        );
        const contactBand = heightAboveDeck >= -0.24 && heightAboveDeck <= 0.38;
        const nearRestingDeck = Math.abs(heightAboveDeck) <= 0.10
          && Math.abs(verticalSpeed) <= 0.22;
        const groundedOnLift = withinLift
          && contactBand
          && (movement?.grounded === true
            || this.game.dog?.grounded === true
            || footSupported
            || nearRestingDeck);

        if (groundedOnLift) {
          lift.riderLatched = true;
          lift.everBoarded = true;
        } else if (!withinLift
          || heightAboveDeck < -0.42
          || heightAboveDeck > 0.72
          || verticalSpeed > 0.65) {
          lift.riderLatched = false;
        }

        const rider = withinLift
          && lift.riderLatched === true
          && heightAboveDeck >= -0.30
          && heightAboveDeck <= 0.88
          && Math.abs(verticalSpeed) <= 0.65;

        // No timeout starts an empty lift. Boarding is the explicit start command.
        if (lift.enabled && rider && !lift.returning && !lift.completed) {
          lift.started = true;
        }

        lift.previousY = previousY;
        if (lift.returning) {
          lift.currentY = Math.max(lift.baseY, previousY - lift.speed * step);
          if (lift.currentY <= lift.baseY + 0.001) {
            lift.currentY = lift.baseY;
            lift.returning = false;
            lift.started = false;
            lift.completed = false;
            lift.riderLatched = false;
            lift.everBoarded = false;
          }
        } else if (lift.enabled && lift.started && !lift.completed) {
          lift.currentY = Math.min(lift.targetY, previousY + lift.speed * step);
        } else {
          lift.currentY = previousY;
        }

        const dy = lift.currentY - previousY;
        if (rider) {
          ridingPlatform = true;
          if (Math.abs(dy) > 1e-7) {
            // Movement applies a -0.025 m grounded adhesion step each tick.
            // Pre-carry that amount too, so the controller's adhesion and the
            // platform's kinematic rise cancel cleanly in the same fixed step.
            dogPosition.y += dy + 0.025;
            this.activePhysics.setPosition({
              x: dogPosition.x,
              y: dogPosition.y + 0.78,
              z: dogPosition.z
            });
          }
          if (movement) {
            movement.grounded = true;
            movement.verticalVelocity = 0;
            if (movement.platformCarryVelocity) {
              movement.platformCarryVelocity.x = 0;
              movement.platformCarryVelocity.y = step > 1e-5 ? dy / step : 0;
              movement.platformCarryVelocity.z = 0;
            }
          }
          if (this.game.dog) {
            this.game.dog.grounded = true;
            this.game.dog.verticalVelocity = 0;
          }
        }

        if (lift.currentY >= lift.targetY - 0.001) {
          lift.currentY = lift.targetY;
          lift.completed = true;
        }

        const liftTarget = { x: lift.x, y: lift.currentY, z: lift.z };
        const kinematicType = this.activePhysics.api.RigidBodyType.KinematicPositionBased;
        if (typeof record.body.bodyType === 'function'
          && record.body.bodyType() !== kinematicType) {
          record.body.setBodyType(kinematicType, true);
        }
        // Crucial: do not setTranslation() here. Teleporting a kinematic body
        // every tick erases its motion velocity. The next pose must be submitted
        // only through setNextKinematicTranslation() before world.step().
        record.body.setNextKinematicTranslation(liftTarget);
        record.body.wakeUp?.();
      }
    }
    if (!ridingPlatform && movement?.grounded && movement.platformCarryVelocity) {
      movement.platformCarryVelocity.set(0, 0, 0);
    }
  }

  syncBoardRiders() {
    // Kinematic platforms carry grounded riders before the fixed physics step.
  }

  interpolateBoards(alpha) {
    if (![3, 4, 5].includes(this.activeLevel?.id)) return;
    for (const record of this.activePhysics?.dynamicProps || []) {
      const motion = record.group?.userData?.boardMotion;
      if (motion) {
        record.group.position.x = THREE.MathUtils.lerp(motion.previousRenderX, motion.currentRenderX, alpha);
        record.group.position.z = THREE.MathUtils.lerp(motion.previousRenderZ, motion.currentRenderZ, alpha);
      }
      const spin = record.group?.userData?.spinMotion;
      if (spin) {
        record.group.rotation.y = THREE.MathUtils.lerp(spin.previousAngle, spin.currentAngle, alpha);
      }
      const lift = record.group?.userData?.liftMotion;
      if (lift) {
        record.group.position.y = THREE.MathUtils.lerp(lift.previousY, lift.currentY, alpha);
      }
    }
  }

  updateSpecialMechanic(level, position, dt) {
    const special = this.special;
    if (!special) return false;
    if (special.type === 'observatory') return updateObservatoryLevel5(this, level, position, dt);
    if (special.completed) return false;
    const near = (point, radius = 1.25) => Math.hypot(position.x - point.x, position.z - point.z) <= radius;
    const interact = () => {
      const value = Boolean(this.game.input?.consumeInteract?.());
      if (value) this.game.input?.consumeLongInteract?.();
      return value;
    };

    if (special.type === 'crates') {
      const p = special.crate.position;
      const distance = Math.hypot(p.x - special.crateTarget.x, p.z - special.crateTarget.z);
      if (distance <= 0.92) {
        special.completed = true;
        special.targetRing.visible = false;
        const record = this.activePhysics?.dynamicPropsById?.get('level3-crate');
        if (record) {
          record.body.setTranslation({ x:p.x, y:special.crateBaseY, z:p.z }, true);
          record.body.setRotation({ x:0, y:0, z:0, w:1 }, true);
          record.body.setLinvel({ x:0, y:0, z:0 }, true);
          record.body.setAngvel({ x:0, y:0, z:0 }, true);
          record.body.setGravityScale(0, true);
          try { record.body.setBodyType(this.activePhysics.api.RigidBodyType.Fixed, true); } catch {}
        }
        special.crate.position.y = special.crateBaseY;
        special.crate.rotation.set(0,0,0);
        this.setPrompt('Balok terkunci pada target! Lanjutkan ke Timber Beacon dan FINISH.');
        return false;
      }
      this.setPrompt('Dorong balok kayu ke lingkaran emas. Jarak: ' + distance.toFixed(1) + ' m.');
      return true;
    }

    if (special.type === 'catapult') {
      if (!special.fired) {
        if (!near(special.catapultPosition, 1.45)) {
          this.setPrompt('Dek awal: dekati katapel di tengah, hancurkan gerbang untuk membuka jembatan violet.');
          return true;
        }
        this.setPrompt('Katapel siap. Tekan INTERAKSI untuk melontarkan bola ke gerbang.');
        if (!interact()) return true;
        special.fired = true;
        special.fireElapsed = 0;
        special.catapultArm.rotation.x = -0.72;
        const record = this.activePhysics?.dynamicPropsById?.get(special.projectileId);
        if (record) {
          record.body.setTranslation(special.projectileStart, true);
          record.body.setLinvel({ x:0, y:0, z:0 }, true);
          record.body.setAngvel({ x:0, y:0, z:0 }, true);
          record.body.applyImpulse({ x:0, y:2.3, z:15.5 }, true);
        }
        return true;
      }
      special.fireElapsed += Math.min(0.05, Math.max(0, dt));
      const p = special.projectile.position;
      const b = special.barrier.position;
      const hit = Math.abs(p.x-b.x)<1.12 && p.z>=b.z-0.72 && p.y>0.08 && p.y<2.65;
      if (hit || (p.z>b.z+0.15 && Math.abs(p.x-b.x)<1.25)) {
        const record = this.activePhysics?.dynamicPropsById?.get(special.barrierId);
        setRigidBodyCollidersEnabled(record?.body, false);
        special.barrier.visible = false;
        special.bridge.visible = true;
        if (!special.bridgeCollider && this.activePhysics?.world && this.activePhysics?.api) {
          special.bridgeCollider = this.activePhysics.world.createCollider(
            this.activePhysics.api.ColliderDesc.cuboid(1.08,0.10,0.78).setTranslation(special.bridgePosition.x,special.bridgePosition.y,special.bridgePosition.z).setFriction(0.82),
            this.activePhysics.fixedBody
          );
        }
        special.completed = true;
        this.setPrompt('Gerbang hancur! Jembatan violet terbuka. Aktifkan Ruin Beacon lalu injak FINISH.');
        return false;
      }
      if (special.fireElapsed > 3.0) {
        const record = this.activePhysics?.dynamicPropsById?.get(special.projectileId);
        if (record) {
          record.body.setTranslation(special.projectileStart, true);
          record.body.setRotation({ x:0, y:0, z:0, w:1 }, true);
          record.body.setLinvel({ x:0, y:0, z:0 }, true);
          record.body.setAngvel({ x:0, y:0, z:0 }, true);
        }
        special.fired = false;
        special.catapultArm.rotation.x = 0;
        this.setPrompt('Bola meleset. Katapel diatur ulang, coba lagi.');
      }
      return true;
    }

    if (special.type === 'braidel-ball') {
      const ball = special.ball.position;
      const target = special.opponent.position;
      const record = this.activePhysics?.dynamicPropsById?.get(special.ballId);
      if (special.ballInFlight) {
        special.flightElapsed += Math.min(0.05, Math.max(0, dt));
        const arrived = ball.z >= target.z-1 && Math.abs(ball.x-target.x)<=1.55;
        if (!arrived && special.flightElapsed <= 2.8) {
          this.setPrompt('Bola menuju Braidel. Reli ' + (special.rallies+1) + '/3.');
          return true;
        }
        special.returnWasSuccess = arrived || ball.z > target.z-1.8;
        special.ballInFlight = false;
        special.returning = true;
        special.returnElapsed = 0;
        special.returnStart = { x:ball.x, y:ball.y, z:ball.z };
        record?.body?.setLinvel({ x:0,y:0,z:0 }, true);
        record?.body?.setAngvel({ x:0,y:0,z:0 }, true);
      }
      if (special.returning) {
        special.returnElapsed += Math.min(0.05, Math.max(0, dt));
        const t = THREE.MathUtils.clamp(special.returnElapsed/0.72,0,1);
        const eased=t*t*(3-2*t);
        const start=special.returnStart, origin=special.ballStart;
        const next={x:THREE.MathUtils.lerp(start.x,origin.x,eased),y:THREE.MathUtils.lerp(start.y,origin.y,eased)+Math.sin(t*Math.PI)*0.62,z:THREE.MathUtils.lerp(start.z,origin.z,eased)};
        special.ball.position.set(next.x,next.y,next.z);
        if(record){record.body.setTranslation(next,true);record.body.setLinvel({x:0,y:0,z:0},true);record.body.setAngvel({x:0,y:0,z:0},true);}
        if(t>=1){
          special.returning=false;
          special.ball.position.set(origin.x,origin.y,origin.z);
          if(record){record.body.setTranslation(origin,true);record.body.setLinvel({x:0,y:0,z:0},true);record.body.setAngvel({x:0,y:0,z:0},true);}
          if(special.returnWasSuccess)special.rallies+=1;
          if(special.rallies>=3){special.completed=true;this.setPrompt('RELI MENANG! Aktifkan Rally Beacon lalu injak FINISH.');return false;}
        }
        return true;
      }
      if(near(ball,1.35)){
        this.setPrompt('Bola siap. Tekan INTERAKSI untuk memukul ke arah Braidel. Reli '+special.rallies+'/3.');
        if(interact()&&record){
          record.body.setLinvel({x:0,y:0,z:0},true);record.body.setAngvel({x:0,y:0,z:0},true);
          const dx=target.x-ball.x,dz=target.z-ball.z;
          record.body.applyImpulse({x:THREE.MathUtils.clamp(dx,-1.5,1.5)*0.9,y:0.55,z:Math.max(2.6,dz*0.82)},true);
          special.ballInFlight=true;special.flightElapsed=0;
        }
      }else this.setPrompt('Misi Braidel: dekati bola di tengah lapangan.');
      return true;
    }
    return false;
  }

  moveDogTo(rootPosition, physics) {
    const dog = this.game.dog;
    if (!dog?.group || !rootPosition) return;
    dog.group.position.set(rootPosition.x, rootPosition.y, rootPosition.z);
    if (Number.isFinite(rootPosition.yaw)) {
      dog.group.rotation.y = rootPosition.yaw;
      const half = rootPosition.yaw * 0.5;
      const rotation = { x:0, y:Math.sin(half), z:0, w:Math.cos(half) };
      physics?.body?.setRotation?.(rotation, true);
      physics?.body?.setNextKinematicRotation?.(rotation);
    }
    physics?.setPosition?.({ x:rootPosition.x, y:rootPosition.y+0.78, z:rootPosition.z });
    const movement = this.game.movement;
    movement?.horizontalVelocity?.set(0,0,0);
    if (movement) {
      movement.verticalVelocity=0;
      movement.grounded=true;
      movement.runJumpActive=false;
      movement.sprintJumpGraceTimer=0;
    }
    if (dog.worldVelocity) Object.assign(dog.worldVelocity,{x:0,y:0,z:0});
  }

  async returnHome(collectedItem) {
    if (!this.activeLevel || this.transitioning) return;
    const returnLevelId = this.activeLevel.id;
    const usePortalFade = returnLevelId === 1 || returnLevelId === 2 || returnLevelId === 3 || returnLevelId === 4 || returnLevelId === 5;
    this.transitioning = true;
    try {
      if (usePortalFade) {
        this.game.setLevelTransitionFrozen?.(true);
        this.game.input?.setLocked?.(true);
        await this.fadePortal(true, 1100);
      }

      const physics = this.activePhysics;
      const arena = this.activeArena;
      this.activeLevel = null;
      this.activePhysics = null;
      this.activeArena = null;
      this.questObject = null;
      this.animatedMechanic = null;
      this.animatedMechanic2 = null;
      this.special = null;
      this.checkpointGroups = [];
      this.checkpointIndex = 0;
      this.parkourRespawnPoint = null;
      this.finishTriggerLatched = false;

      if (physics && physics !== this.basePhysics) physics.dispose();
      this.game.physics = this.basePhysics;
      this.game.movement.physics = this.basePhysics;
      this.game.movement.setWorldBounds?.(null);
      this.game.inventory.physics = this.basePhysics;
      this.game.inventory.levelMode = false;
      this.shelter.root.visible = true;
      this.game.movement.surfaceTraction = 1;

      for (const saved of this.hiddenPickupRoots) if (saved.root) saved.root.visible = saved.visible;
      this.hiddenPickupRoots = [];
      if (this.game.inventory?.ringIdleMesh) this.game.inventory.ringIdleMesh.visible = true;
      if (this.game.inventory?.ringActiveMesh) this.game.inventory.ringActiveMesh.visible = true;
      if (arena) this.disposeArena(arena);

      const returnPosition = returnLevelId === 1
        ? LEVEL_ONE_RETURN
        : returnLevelId === 2 ? LEVEL_TWO_RETURN
          : returnLevelId === 3 ? LEVEL_THREE_RETURN
          : returnLevelId === 4 ? LEVEL_FOUR_RETURN : HOME;
      this.moveDogTo(returnPosition, this.basePhysics);
      if (returnLevelId === 1) this.level1PortalReentryBlocked = true;
      if (returnLevelId === 2) this.level2PortalReentryBlocked = true;
      if (returnLevelId === 3) this.level3PortalReentryBlocked = true;
      if (returnLevelId === 4) this.level4PortalReentryBlocked = true;
      this.game.resetRenderPositionSnapshots?.();
      this.game.cameraRig.worldRoot = this.shelter.root;
      this.game.cameraRig.cacheCameraOccluders();
      this.game.cameraRig.resetView(
        this.game.dog?.group?.position,
        usePortalFade ? returnPosition.yaw : 0.12
      );
      this.refreshGiftRequirement();
      this.game.inventory?.updateInteractionUI?.(true);
      this.setPrompt(collectedItem
        ? 'Kembali ke kado dan injak tombol setelah kelima benda level terkumpul.'
        : 'Kembali ke shelter.');
    } finally {
      if (usePortalFade && this.game.levelTransitionFrozen) {
        await this.fadePortal(false, 1400);
        this.game.input?.setLocked?.(false);
        this.game.setLevelTransitionFrozen?.(false);
      }
      this.transitioning = false;
    }
  }

  setPrompt(message) {
    if(this.currentPrompt===message)return;
    this.currentPrompt=message;
    const prompt=this.game.inventory?.prompt;
    const text=this.game.inventory?.promptText;
    if(!prompt||!text)return;
    text.textContent=message;
    prompt.hidden=false;
    prompt.classList.add('is-active');
  }

  buildArena(level) {
    const group=new THREE.Group(); group.name='VisitedLevelArena-'+level.id;
    const solids=[]; const materialCache=new Map();
    const material=(color,metalness=0.02)=>{
      const key=color+':'+metalness;
      if(!materialCache.has(key))materialCache.set(key,new THREE.MeshStandardMaterial({color,roughness:0.76,metalness,flatShading:true}));
      return materialCache.get(key);
    };
    const box=(name,x,y,z,sx,sy,sz,color,collidable=true,metalness=0.02,parent=group)=>{
      const mesh=new THREE.Mesh(new THREE.BoxGeometry(sx,sy,sz),material(color,metalness));
      mesh.name=name;mesh.position.set(x,y,z);mesh.castShadow=false;mesh.receiveShadow=true;parent.add(mesh);
      if(collidable)solids.push({x,y,z,sx:sx*0.5,sy:sy*0.5,sz:sz*0.5});
      return mesh;
    };
    const parkourCourse=PARKOUR_COURSES[level.id]||null;
