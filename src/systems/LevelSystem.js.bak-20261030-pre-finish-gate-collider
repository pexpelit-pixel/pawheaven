          const initialZ=platform.z+(motionAxis==='z'?initialOffset:0);
          const origin={x:initialX,y:bottom+thickness*0.5,z:initialZ};
          board.name='Level'+level.id+'-MovingBoard-'+platform.name;
          board.position.set(origin.x,origin.y,origin.z);
          group.add(board);

          let choiceState=null;
          if(platform.choiceGroup){
            choiceState=choiceStates.get(platform.choiceGroup);
            if(!choiceState){
              const trigger=platform.choiceTrigger||{x:platform.x,z:platform.z};
              choiceState={
                id:platform.choiceGroup,
                trigger:{x:trigger.x,z:trigger.z},
                radius:platform.choiceRadius||6.0,
                duration:platform.choiceDuration||4.0,
                cooldown:platform.choiceCooldown||0.8,
                started:false,
                activeSide:null,
                remaining:0,
                lastSide:0
              };
              choiceStates.set(platform.choiceGroup,choiceState);
            }
          }

          let deckMesh;
          if(choiceState){
            const choiceMaterial=new THREE.MeshStandardMaterial({
              color:'#756a91',emissive:'#302543',emissiveIntensity:0.12,
              transparent:true,opacity:0.20,depthWrite:false,roughness:0.54,
              metalness:0.16,flatShading:true
            });
            deckMesh=new THREE.Mesh(new THREE.BoxGeometry(platform.width,thickness,platform.depth),choiceMaterial);
            deckMesh.name='TimedChoiceDeck-'+platform.name;
            deckMesh.castShadow=false;
            deckMesh.receiveShadow=true;
            deckMesh.visible=false;
            board.add(deckMesh);
          }else{
            deckMesh=box('MovingDeck',0,0,0,platform.width,thickness,platform.depth,platform.color,false,0.04,board);
          }

          const motion={
            axis:motionAxis,
            baseX:platform.x,baseZ:platform.z,
            range:motionRange,
            speed:motionSpeed,
            phase:motionPhase,
            top:platform.top,width:platform.width,spanZ:platform.depth,
            elapsed:0,
            previousRenderX:initialX,previousRenderZ:initialZ,
            currentRenderX:initialX,currentRenderZ:initialZ,
            choiceState,
            choiceSide:platform.choiceSide||0,
            choiceMesh:choiceState?deckMesh:null,
            choiceEnabled:choiceState?false:null
          };
          board.userData.boardMotion=motion;
          const prop={
            id:'level'+level.id+'-moving-platform-'+platform.name,
            group:board,origin,spawnLift:0,mass:80,gravityScale:0,
            linearDamping:0,angularDamping:0,friction:0.9,
            restitution:0,ccdEnabled:false,canSleep:false
          };
          solids.push({
            x:origin.x,y:origin.y,z:origin.z,
            sx:platform.width*0.5,sy:thickness*0.5,sz:platform.depth*0.5,
            dynamicProp:prop
          });
          continue;
        }

        box('Parkour-'+platform.name,platform.x,bottom+thickness*0.5,platform.z,
          platform.width,thickness,platform.depth,platform.color,true,0.04);
        if(!platform.start&&bottom>0.14){
          const h=bottom-0.09;
          const rw=Math.min(platform.beam?0.24:0.54,platform.width*0.46);
          const rd=Math.min(0.56,platform.depth*0.42);
          box('Root-'+platform.name,platform.x,0.09+h*0.5,platform.z,rw,h,rd,
            level.id===1?'#385f56':level.id===4?'#51456e':'#315b75',false,0.01);
        }
        const edgeW=Math.max(0.18,platform.width-0.12);
        const edgeD=Math.max(0.18,platform.depth-0.12);
        const ty=platform.top+0.006;
        box('EdgeFront-'+platform.name,platform.x,ty,platform.z-platform.depth*0.5+0.045,edgeW,0.025,0.045,platform.edge,false,0.08);
        box('EdgeBack-'+platform.name,platform.x,ty,platform.z+platform.depth*0.5-0.045,edgeW,0.025,0.045,platform.edge,false,0.08);
        box('EdgeLeft-'+platform.name,platform.x-platform.width*0.5+0.045,ty,platform.z,0.045,0.025,edgeD,platform.edge,false,0.08);
        box('EdgeRight-'+platform.name,platform.x+platform.width*0.5-0.045,ty,platform.z,0.045,0.025,edgeD,platform.edge,false,0.08);

        if(platform.spinBar){
          const length=Number.isFinite(platform.spinLength)?platform.spinLength:3.0;
          const spinHeight=Number.isFinite(platform.spinHeight)?platform.spinHeight:0.82;
          const origin={x:platform.x,y:platform.top+spinHeight,z:platform.z};
          const spinner=new THREE.Group();
          spinner.name='Level4-HoloRotor-'+platform.name;
          spinner.position.set(origin.x,origin.y,origin.z);
          const core=box('HoloRodCore',0,0,0,length,0.13,0.15,'#79eaff',false,0.32,spinner);
          core.material.emissive.set('#259ac0');
          core.material.emissiveIntensity=0.9;
          for(const side of [-1,1]){
            const cap=box('HoloRodCap-'+side,side*length*0.47,0,0,0.18,0.20,0.22,'#f2ddff',false,0.26,spinner);
            cap.material.emissive.set('#a77aff');
            cap.material.emissiveIntensity=0.8;
          }
          const hub=box('HoloRodHub',0,0,0,0.30,0.24,0.30,'#d9c2ff',false,0.3,spinner);
          hub.material.emissive.set('#9a75e2');
          hub.material.emissiveIntensity=0.7;
          const phase=Number.isFinite(platform.spinPhase)?platform.spinPhase:0;
          spinner.rotation.y=phase;
          const spinMotion={
            speed:Number.isFinite(platform.spinSpeed)?platform.spinSpeed:1.4,
            phase,elapsed:0,previousAngle:phase,currentAngle:phase
          };
          spinner.userData.spinMotion=spinMotion;
          group.add(spinner);
          const prop={
            id:'level4-holo-rotor-'+platform.name,
            group:spinner,origin,spawnLift:0,mass:8,gravityScale:0,
            linearDamping:0,angularDamping:0,friction:0.62,
            restitution:0,ccdEnabled:false,canSleep:false
          };
          solids.push({
            x:origin.x,y:origin.y,z:origin.z,
            sx:length*0.5,sy:0.075,sz:0.085,
            dynamicProp:prop
          });
        }
      }
    }else{
      level.obstacles?.forEach((obstacle,index)=>{
        const [x,z,w,h,d,color]=obstacle;
        box('Obstacle-'+index,x,0.0775+h*0.5,z,w,h,d,color,true,level.id===5?0.22:0.04);
      });
      for(let i=0;i<5;i++){
        const x=Math.sin((i+1)*(level.id+1)*0.58)*5.2,z=-5.8+i*2.65;
        box('PathPad-'+i,x,0.16,z,1.05,0.16,0.88,i%2?level.bright:'#fff0df',false);
      }
    }

    // Low-poly signatures: sky wind gates, time ring, bridge path and clockwork gear.
    let animatedMechanic = null;
    let animatedMechanic2 = null;
    let special = null;
    const addArenaGear = (name, x, y, z, radius, color) => {
      const gear = new THREE.Group();
      gear.name = name;
      gear.position.set(x, y, z);
      const ringMesh = new THREE.Mesh(new THREE.TorusGeometry(radius, 0.075, 5, 20), material(color, 0.48));
      ringMesh.rotation.x = Math.PI / 2;
      ringMesh.castShadow = false;
      gear.add(ringMesh);
      for (let tooth = 0; tooth < 8; tooth++) {
        const angle = tooth * Math.PI / 4;
        const mesh = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.11, 0.27), material(color, 0.38));
        mesh.position.set(Math.cos(angle) * (radius + 0.06), 0, Math.sin(angle) * (radius + 0.06));
        mesh.rotation.y = -angle;
        mesh.castShadow = false;
        gear.add(mesh);
      }
      group.add(gear);
      return gear;
    };
    if (level.id === 2) {
      // Decorative wind gates frame the route from the distant sides without blocking the jump path.
      for (const [index, z] of [-4.2, 1.2, 6.5].entries()) {
        box('Level2-WindGateLeft-' + index, -6.7, 1.20, z, 0.14, 2.35, 0.14, '#b7eff2', false, 0.18);
        box('Level2-WindGateRight-' + index, 6.7, 1.20, z, 0.14, 2.35, 0.14, '#73bfd0', false, 0.18);
        box('Level2-WindGateTopL-' + index, -6.7, 2.34, z, 1.65, 0.12, 0.14, '#d4f6f7', false, 0.18);
        box('Level2-WindGateTopR-' + index, 6.7, 2.34, z, 1.65, 0.12, 0.14, '#d4f6f7', false, 0.18);
      }
    } else if (level.id === 3) {
      const timeRing = new THREE.Group();
      timeRing.name = 'Level3-TimeMachineRing';
      timeRing.position.set(3.4, 1.35, -24.6);
      const outer = new THREE.Mesh(new THREE.TorusGeometry(0.83, 0.10, 6, 24), material('#ffbd72', 0.3));
      outer.castShadow = false;
      const inner = new THREE.Mesh(new THREE.TorusGeometry(0.55, 0.045, 5, 20), material('#c76d4a', 0.36));
      inner.castShadow = false;
      timeRing.add(outer, inner);
      group.add(timeRing);
      animatedMechanic = timeRing;
    } else if (level.id === 4) {
      // Twin decorative pylons frame the direct parkour start deck.
      box('Level4-StartPylonL', -3.45, 0.84, -25.8, 0.24, 0.82, 0.24, '#b8a0df', false, 0.12);
      box('Level4-StartPylonR', 3.45, 0.84, -25.8, 0.24, 0.82, 0.24, '#9677bd', false, 0.12);
    }

    const makeSphere = (parent, name, color, position, scale, metalness = 0.02) => {
      const mesh = new THREE.Mesh(new THREE.SphereGeometry(1, 10, 8), material(color, metalness));
      mesh.name = name;
      mesh.position.set(position[0], position[1], position[2]);
      mesh.scale.set(scale[0], scale[1], scale[2]);
      mesh.castShadow = false;
      mesh.receiveShadow = true;
      parent.add(mesh);
      return mesh;
    };
    const makeRing = (name, x, z, color, radius = 0.72) => {
      const mesh = new THREE.Mesh(new THREE.TorusGeometry(radius, 0.035, 5, 18), material(color, 0.12));
      mesh.name = name;
      mesh.rotation.x = Math.PI / 2;
      mesh.position.set(x, 0.125, z);
      group.add(mesh);
      return mesh;
    };

    if (level.id === 1) {
      // Rotating low-poly saw hazard inspired by the molesaw/impulse source nodes in level01.
      const sawPlatform = LEVEL_ONE_PARKOUR.platforms.find((platform) => platform.saw);
      animatedMechanic = addArenaGear('Level1-MossSaw', sawPlatform.x, sawPlatform.top + 0.13,
        sawPlatform.z, 0.34, '#d4c18a');
      solids.push({ x: sawPlatform.x, y: sawPlatform.top + 0.07, z: sawPlatform.z,
        sx: 0.34, sy: 0.07, sz: 0.34, shape: 'cylinder', radius: 0.34, halfHeight: 0.07 });
    } else if (level.id === 2) {
      // Two counter-rotating wind hazards guard narrow islands. Their simple colliders stay cheap on mobile.
      const rotorPlatforms = LEVEL_TWO_PARKOUR.platforms.filter((platform) => platform.rotor);
      const rotorA = rotorPlatforms[0];
      const rotorB = rotorPlatforms[1];
      animatedMechanic = addArenaGear('Level2-SkyRotorA', rotorA.x, rotorA.top + 0.13,
        rotorA.z, 0.38, '#ffe6a9');
      animatedMechanic2 = addArenaGear('Level2-SkyRotorB', rotorB.x, rotorB.top + 0.13,
        rotorB.z, 0.34, '#fff0cf');
      for (const rotor of rotorPlatforms) {
        const radius = rotor === rotorA ? 0.38 : 0.34;
        solids.push({ x: rotor.x, y: rotor.top + 0.07, z: rotor.z,
          sx: radius, sy: 0.07, sz: radius, shape: 'cylinder', radius, halfHeight: 0.07 });
      }
      for (let i = 0; i < 6; i++) {
        const cloudX = -6.0 + i * 2.15;
        const cloudZ = -4.8 + (i % 3) * 4.8;
        makeSphere(group, 'Level2-CloudPuff-' + i, '#b7eff2', [cloudX, 0.45, cloudZ], [1.02, 0.16, 0.66]);
      }
      special = null;
    } else if (level.id === 3) {
      // A real Rapier-driven crate rather than a fake position-only puzzle prop.
      const crate = new THREE.Group();
      crate.name = 'Level3-PushableCrate';
      box('CrateCore', 0, 0, 0, 0.98, 0.98, 0.98, '#a96842', false, 0.02, crate);
      for (const y of [-0.34, 0, 0.34]) {
        box('CrateFrontRail-' + y, 0, y, -0.503, 0.98, 0.09, 0.055, '#d79b64', false, 0.01, crate);
        box('CrateSideRail-' + y, 0.503, y, 0, 0.055, 0.09, 0.98, '#d79b64', false, 0.01, crate);
      }
      const braceA = box('CrateBraceA', 0, 0, -0.54, 0.10, 0.88, 0.035, '#e3b47d', false, 0.01, crate);
      braceA.rotation.z = 0.55;
      const braceB = box('CrateBraceB', 0, 0, -0.545, 0.10, 0.88, 0.035, '#e3b47d', false, 0.01, crate);
      braceB.rotation.z = -0.55;
      const crateBaseY = LEVEL_THREE_PARKOUR.platforms.find((platform) => platform.start).top + 0.49;
      crate.position.set(2.45, crateBaseY, -26.2);
      group.add(crate);
      const crateProp = {
        id: 'level3-crate', group: crate, origin: { x: 2.45, y: crateBaseY, z: -26.2 },
        spawnLift: 0, mass: 12, gravityScale: 1, linearDamping: 0.72, angularDamping: 2.6,
        friction: 0.9, restitution: 0.025, ccdEnabled: true, canSleep: false
      };
      solids.push({ x: 2.45, y: crateBaseY, z: -26.2, sx: 0.5, sy: 0.5, sz: 0.5, dynamicProp: crateProp });
      const targetRing = makeRing('Level3-CrateTarget', -2.4, -24.0, '#ffcf75', 0.82);
      targetRing.position.y = LEVEL_THREE_PARKOUR.platforms.find((platform) => platform.start).top + 0.025;
      special = { type: 'crates', completed: false, crate, crateBaseY, crateTarget: { x: -2.4, z: -24.0 }, targetRing };
    } else if (level.id === 4) {
      // Level 4 starts directly as a parkour course; no launcher or gate objective.
      special = null;
    } else if (level.id === 5) {
      special = buildObservatoryLevel5({ group, box, solids });
    }

    const checkpointGroups = [];
    const checkpointPoints = PUZZLE_SEQUENCES[level.id] || [];
    for (let i = 0; i < checkpointPoints.length; i++) {
      const [x, z] = checkpointPoints[i];
      const marker = new THREE.Group();
      marker.name = 'Level' + level.id + '-Step-' + (i + 1);
      marker.visible = i === 0;
      const surfaceY = checkpointPoints[i][2];
      marker.userData.point = { x, z, ...(Number.isFinite(surfaceY) ? { y: surfaceY } : {}) };
      if (PARKOUR_COURSES[level.id] && Number.isFinite(surfaceY)) marker.position.y = surfaceY - 0.0775;
      group.add(marker);
      box('StepPad-' + level.id + '-' + i, x, 0.108, z, 1.08, 0.035, 1.08, level.color, false, 0.08, marker);
      box('StepPost-' + level.id + '-' + i, x, 0.42, z, 0.22, 0.60, 0.22, level.bright, false, 0.16, marker);
      box('StepCap-' + level.id + '-' + i, x, 0.76, z, 0.42, 0.10, 0.42, '#fff0df', false, 0.08, marker);
      if (PARKOUR_COURSES[level.id]) {
        const orbColor = level.id === 1 ? '#fff0df' : '#e0fcff';
        const beaconOrb = new THREE.Mesh(new THREE.SphereGeometry(0.16, 8, 6), material(orbColor, 0.18));
        beaconOrb.name = 'Level' + level.id + '-BeaconOrb-' + (i + 1);
        beaconOrb.position.set(0, 0.93, 0);
        marker.add(beaconOrb);
        const beaconHalo = new THREE.Mesh(new THREE.TorusGeometry(0.23, 0.025, 5, 16), material(level.bright, 0.18));
        beaconHalo.name = 'Level' + level.id + '-BeaconHalo-' + (i + 1);
        beaconHalo.rotation.x = Math.PI / 2;
        beaconHalo.position.set(0, 0.93, 0);
        marker.add(beaconHalo);
      }
      checkpointGroups.push(marker);
    }

    const itemGeometry = new THREE.OctahedronGeometry(0.34, 0);
    const itemMaterial = new THREE.MeshStandardMaterial({
      color: level.bright, emissive: level.color, emissiveIntensity: 0.6,
      roughness: 0.3, metalness: 0.2, flatShading: true
    });
    const questObject = new THREE.Group();
    questObject.name = 'LevelQuestCollectible-' + level.id;
    const questFinish = PARKOUR_COURSES[level.id]?.platforms.find((platform) => platform.finish);
    questObject.position.set(questFinish?.x ?? level.itemX,
      questFinish ? questFinish.top + 0.48 : 0.52,
      questFinish?.z ?? 8.1);
    const relic = new THREE.Mesh(itemGeometry, itemMaterial);
    relic.name = 'LevelQuestRelic-' + level.id;
    relic.castShadow = false;
    relic.receiveShadow = false;
    questObject.add(relic);
    const ring = new THREE.Mesh(
      new THREE.TorusGeometry(0.48, 0.025, 6, 24),
      new THREE.MeshStandardMaterial({ color: level.bright, emissive: level.color, emissiveIntensity: 0.4, roughness: 0.45 })
    );
    ring.name = 'LevelQuestRing-' + level.id;
    ring.rotation.x = Math.PI / 2;
    ring.position.y = -0.32;
    questObject.add(ring);
    questObject.visible = false;
    group.add(questObject);

    const finishPlatform = parkourCourse?.platforms.find((platform) => platform.finish) || null;
    const finishX = finishPlatform?.x ?? level.itemX;
    const finishZ = finishPlatform?.z ?? 8.1;
    const finishY = finishPlatform?.top ?? 0.0775;
    const finishZone = level.finishTrigger || { x: finishX, z: finishZ, rx: 1.05, rz: 0.92 };
    const pressurePlate = new THREE.Group();
    pressurePlate.name = 'Level' + level.id + '-FinishPressurePlate';
    pressurePlate.position.set(finishX, finishY + 0.002, finishZ);
    pressurePlate.userData.finishPoint = { x: finishX, y: finishY, z: finishZ };
    pressurePlate.userData.zone = finishZone;
    pressurePlate.userData.triggerHalfWidth = finishZone.rx;
    pressurePlate.userData.triggerHalfDepth = finishZone.rz;
    const baseMesh = new THREE.Mesh(new THREE.BoxGeometry(1.70, 0.05, 1.32),
      new THREE.MeshStandardMaterial({ color: '#315b75', emissive: '#173b52', emissiveIntensity: 0.35, roughness: 0.56, metalness: 0.14, flatShading: true }));
    baseMesh.name = 'FinishPressurePlateBase';
    baseMesh.position.y = 0.025;
    baseMesh.castShadow = false;
    baseMesh.receiveShadow = true;
    pressurePlate.add(baseMesh);
    const plateMaterial = new THREE.MeshStandardMaterial({ color: level.bright, emissive: level.color, emissiveIntensity: 0.28, roughness: 0.36, metalness: 0.12, flatShading: true });
    const plateMesh = new THREE.Mesh(new THREE.BoxGeometry(1.45, 0.055, 1.08), plateMaterial);
    plateMesh.name = 'FinishPressurePlateTop';
    plateMesh.position.y = 0.045;
    plateMesh.castShadow = false;
    plateMesh.receiveShadow = true;
    pressurePlate.userData.plate = plateMesh;
    pressurePlate.userData.plateRestY = 0.045;
    pressurePlate.userData.platePressedY = 0.018;
    pressurePlate.userData.plateMaterial = plateMaterial;
    pressurePlate.userData.statusLeds = [];
    pressurePlate.add(plateMesh);
    const mark = new THREE.Mesh(new THREE.CircleGeometry(0.16, 20), new THREE.MeshBasicMaterial({ color: '#ffffff', transparent: true, opacity: 0.9, depthWrite: false, side: THREE.DoubleSide }));
    mark.name = 'FinishPressurePlateMark';
    mark.rotation.x = -Math.PI / 2;
    mark.position.y = 0.029;
    plateMesh.add(mark);
    for (const [index, x, z] of [[0,-0.61,-0.45],[1,0.61,-0.45],[2,-0.61,0.45],[3,0.61,0.45]]) {
      const ledMaterial = new THREE.MeshStandardMaterial({ color: '#86bacc', emissive: '#438ca6', emissiveIntensity: 0.5, roughness: 0.35, metalness: 0.1 });
      const led = new THREE.Mesh(new THREE.SphereGeometry(0.03, 8, 6), ledMaterial);
      led.name = 'FinishPressurePlateLED-' + index;
      led.position.set(x, 0.070, z);
      led.castShadow = false;
      pressurePlate.userData.statusLeds.push(led);
      pressurePlate.add(led);
    }
    group.userData.finishPressurePlate = pressurePlate;
    group.add(pressurePlate);
    if (level.id === 5) pressurePlate.visible = false;

    group.userData.disposeMaterials = [...(group.userData.disposeMaterials || []), ...materialCache.values(), itemMaterial, ring.material];
    group.userData.disposeGeometries = [...(group.userData.disposeGeometries || [])];
    group.traverse((object) => {
      if (object.isMesh && object.geometry !== itemGeometry && object.geometry !== ring.geometry) group.userData.disposeGeometries.push(object.geometry);
    });
    group.userData.disposeGeometries.push(itemGeometry, ring.geometry);
    return { group, solids, questObject, checkpointGroups, animatedMechanic, animatedMechanic2, special };
  }

  disposeArena(group) {
    this.scene.remove(group);
    group.userData.disposed = true;
    const materials = new Set(group.userData.disposeMaterials || []);
    const geometries = new Set(group.userData.disposeGeometries || []);
    const textures = new Set(group.userData.disposeTextures || []);
    group.traverse((object) => {
      if (object.geometry) geometries.add(object.geometry);
      const list = Array.isArray(object.material) ? object.material : [object.material];
      for (const mat of list) if (mat) materials.add(mat);
    });
    for (const texture of textures) texture.dispose?.();
    for (const geometry of geometries) geometry.dispose?.();
    for (const mat of materials) mat.dispose?.();
    group.clear();
  }

  dispose() {
    if (this.disposed) return;
    this.disposed = true;
    const arena = this.activeArena;
    const activePhysics = this.activePhysics;
    this.activeArena = null;
    this.activePhysics = null;
    this.activeLevel = null;
    this.questObject = null;
    this.animatedMechanic = null;
    this.animatedMechanic2 = null;
    this.special = null;
    if (activePhysics && activePhysics !== this.basePhysics) activePhysics.dispose();
    if (this.game) {
      this.game.physics = this.basePhysics;
      if (this.game.movement) this.game.movement.physics = this.basePhysics;
      if (this.game.inventory) {
        this.game.inventory.physics = this.basePhysics;
        this.game.inventory.levelMode = false;
      }
    }
    if (arena) this.disposeArena(arena);
    this.shelter.root.visible = true;
    for (const saved of this.hiddenPickupRoots) if (saved.root) saved.root.visible = saved.visible;
    this.hiddenPickupRoots = [];
    if (this.game.inventory?.ringIdleMesh) this.game.inventory.ringIdleMesh.visible = true;
    if (this.game.inventory?.ringActiveMesh) this.game.inventory.ringActiveMesh.visible = true;
    if (this.gateCollider && this.basePhysics?.world) {
      try { this.basePhysics.world.removeCollider(this.gateCollider, true); } catch { /* Ignore disposal races. */ }
      this.gateCollider = null;
    }
  }
}
