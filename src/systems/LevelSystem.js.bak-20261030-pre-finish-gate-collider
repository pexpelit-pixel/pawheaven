  interpolateBoards(alpha) {
    if (![3, 4, 5].includes(this.activeLevel?.id)) return;
    for (const record of this.activePhysics?.dynamicProps || []) {
      const motion = record.group?.userData?.boardMotion;
      if (motion) {
        record.group.position.x = THREE.MathUtils.lerp(motion.previousRenderX, motion.currentRenderX, alpha);
        record.group.position.z = THREE.MathUtils.lerp(motion.previousRenderZ, motion.currentRenderZ, alpha);
      }
      const spin = record.group?.userData?.spinMotion;
      if (spin) {
        record.group.rotation.y = THREE.MathUtils.lerp(spin.previousAngle, spin.currentAngle, alpha);
      }
    }
  }

  updateSpecialMechanic(level, position, dt) {
    const special = this.special;
    if (!special) return false;
    if (special.type === 'observatory') return updateObservatoryLevel5(this, level, position, dt);
    if (special.completed) return false;
    const near = (point, radius = 1.25) => Math.hypot(position.x - point.x, position.z - point.z) <= radius;
    const interact = () => {
      const value = Boolean(this.game.input?.consumeInteract?.());
      if (value) this.game.input?.consumeLongInteract?.();
      return value;
    };

    if (special.type === 'crates') {
      const p = special.crate.position;
      const distance = Math.hypot(p.x - special.crateTarget.x, p.z - special.crateTarget.z);
      if (distance <= 0.92) {
        special.completed = true;
        special.targetRing.visible = false;
        const record = this.activePhysics?.dynamicPropsById?.get('level3-crate');
        if (record) {
          record.body.setTranslation({ x:p.x, y:special.crateBaseY, z:p.z }, true);
          record.body.setRotation({ x:0, y:0, z:0, w:1 }, true);
          record.body.setLinvel({ x:0, y:0, z:0 }, true);
          record.body.setAngvel({ x:0, y:0, z:0 }, true);
          record.body.setGravityScale(0, true);
          try { record.body.setBodyType(this.activePhysics.api.RigidBodyType.Fixed, true); } catch {}
        }
        special.crate.position.y = special.crateBaseY;
        special.crate.rotation.set(0,0,0);
        this.setPrompt('Balok terkunci pada target! Lanjutkan ke Timber Beacon dan FINISH.');
        return false;
      }
      this.setPrompt('Dorong balok kayu ke lingkaran emas. Jarak: ' + distance.toFixed(1) + ' m.');
      return true;
    }

    if (special.type === 'catapult') {
      if (!special.fired) {
        if (!near(special.catapultPosition, 1.45)) {
          this.setPrompt('Dek awal: dekati katapel di tengah, hancurkan gerbang untuk membuka jembatan violet.');
          return true;
        }
        this.setPrompt('Katapel siap. Tekan INTERAKSI untuk melontarkan bola ke gerbang.');
        if (!interact()) return true;
        special.fired = true;
        special.fireElapsed = 0;
        special.catapultArm.rotation.x = -0.72;
        const record = this.activePhysics?.dynamicPropsById?.get(special.projectileId);
        if (record) {
          record.body.setTranslation(special.projectileStart, true);
          record.body.setLinvel({ x:0, y:0, z:0 }, true);
          record.body.setAngvel({ x:0, y:0, z:0 }, true);
          record.body.applyImpulse({ x:0, y:2.3, z:15.5 }, true);
        }
        return true;
      }
      special.fireElapsed += Math.min(0.05, Math.max(0, dt));
      const p = special.projectile.position;
      const b = special.barrier.position;
      const hit = Math.abs(p.x-b.x)<1.12 && p.z>=b.z-0.72 && p.y>0.08 && p.y<2.65;
      if (hit || (p.z>b.z+0.15 && Math.abs(p.x-b.x)<1.25)) {
        const record = this.activePhysics?.dynamicPropsById?.get(special.barrierId);
        setRigidBodyCollidersEnabled(record?.body, false);
        special.barrier.visible = false;
        special.bridge.visible = true;
        if (!special.bridgeCollider && this.activePhysics?.world && this.activePhysics?.api) {
          special.bridgeCollider = this.activePhysics.world.createCollider(
            this.activePhysics.api.ColliderDesc.cuboid(1.08,0.10,0.78).setTranslation(special.bridgePosition.x,special.bridgePosition.y,special.bridgePosition.z).setFriction(0.82),
            this.activePhysics.fixedBody
          );
        }
        special.completed = true;
        this.setPrompt('Gerbang hancur! Jembatan violet terbuka. Aktifkan Ruin Beacon lalu injak FINISH.');
        return false;
      }
      if (special.fireElapsed > 3.0) {
        const record = this.activePhysics?.dynamicPropsById?.get(special.projectileId);
        if (record) {
          record.body.setTranslation(special.projectileStart, true);
          record.body.setRotation({ x:0, y:0, z:0, w:1 }, true);
          record.body.setLinvel({ x:0, y:0, z:0 }, true);
          record.body.setAngvel({ x:0, y:0, z:0 }, true);
        }
        special.fired = false;
        special.catapultArm.rotation.x = 0;
        this.setPrompt('Bola meleset. Katapel diatur ulang, coba lagi.');
      }
      return true;
    }

    if (special.type === 'braidel-ball') {
      const ball = special.ball.position;
      const target = special.opponent.position;
      const record = this.activePhysics?.dynamicPropsById?.get(special.ballId);
      if (special.ballInFlight) {
        special.flightElapsed += Math.min(0.05, Math.max(0, dt));
        const arrived = ball.z >= target.z-1 && Math.abs(ball.x-target.x)<=1.55;
        if (!arrived && special.flightElapsed <= 2.8) {
          this.setPrompt('Bola menuju Braidel. Reli ' + (special.rallies+1) + '/3.');
          return true;
        }
        special.returnWasSuccess = arrived || ball.z > target.z-1.8;
        special.ballInFlight = false;
        special.returning = true;
        special.returnElapsed = 0;
        special.returnStart = { x:ball.x, y:ball.y, z:ball.z };
        record?.body?.setLinvel({ x:0,y:0,z:0 }, true);
        record?.body?.setAngvel({ x:0,y:0,z:0 }, true);
      }
      if (special.returning) {
        special.returnElapsed += Math.min(0.05, Math.max(0, dt));
        const t = THREE.MathUtils.clamp(special.returnElapsed/0.72,0,1);
        const eased=t*t*(3-2*t);
        const start=special.returnStart, origin=special.ballStart;
        const next={x:THREE.MathUtils.lerp(start.x,origin.x,eased),y:THREE.MathUtils.lerp(start.y,origin.y,eased)+Math.sin(t*Math.PI)*0.62,z:THREE.MathUtils.lerp(start.z,origin.z,eased)};
        special.ball.position.set(next.x,next.y,next.z);
        if(record){record.body.setTranslation(next,true);record.body.setLinvel({x:0,y:0,z:0},true);record.body.setAngvel({x:0,y:0,z:0},true);}
        if(t>=1){
          special.returning=false;
          special.ball.position.set(origin.x,origin.y,origin.z);
          if(record){record.body.setTranslation(origin,true);record.body.setLinvel({x:0,y:0,z:0},true);record.body.setAngvel({x:0,y:0,z:0},true);}
          if(special.returnWasSuccess)special.rallies+=1;
          if(special.rallies>=3){special.completed=true;this.setPrompt('RELI MENANG! Aktifkan Rally Beacon lalu injak FINISH.');return false;}
        }
        return true;
      }
      if(near(ball,1.35)){
        this.setPrompt('Bola siap. Tekan INTERAKSI untuk memukul ke arah Braidel. Reli '+special.rallies+'/3.');
        if(interact()&&record){
          record.body.setLinvel({x:0,y:0,z:0},true);record.body.setAngvel({x:0,y:0,z:0},true);
          const dx=target.x-ball.x,dz=target.z-ball.z;
          record.body.applyImpulse({x:THREE.MathUtils.clamp(dx,-1.5,1.5)*0.9,y:0.55,z:Math.max(2.6,dz*0.82)},true);
          special.ballInFlight=true;special.flightElapsed=0;
        }
      }else this.setPrompt('Misi Braidel: dekati bola di tengah lapangan.');
      return true;
    }
    return false;
  }

  moveDogTo(rootPosition, physics) {
    const dog = this.game.dog;
    if (!dog?.group || !rootPosition) return;
    dog.group.position.set(rootPosition.x, rootPosition.y, rootPosition.z);
    if (Number.isFinite(rootPosition.yaw)) {
      dog.group.rotation.y = rootPosition.yaw;
      const half = rootPosition.yaw * 0.5;
      const rotation = { x:0, y:Math.sin(half), z:0, w:Math.cos(half) };
      physics?.body?.setRotation?.(rotation, true);
      physics?.body?.setNextKinematicRotation?.(rotation);
    }
    physics?.setPosition?.({ x:rootPosition.x, y:rootPosition.y+0.78, z:rootPosition.z });
    const movement = this.game.movement;
    movement?.horizontalVelocity?.set(0,0,0);
    if (movement) {
      movement.verticalVelocity=0;
      movement.grounded=true;
      movement.runJumpActive=false;
      movement.sprintJumpGraceTimer=0;
    }
    if (dog.worldVelocity) Object.assign(dog.worldVelocity,{x:0,y:0,z:0});
  }

