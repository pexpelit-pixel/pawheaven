import * as THREE from 'three';
import { PhysicsWorld } from '../physics/PhysicsWorld.js';
import { LEVELS, PARKOUR_COURSES, PUZZLE_SEQUENCES, LEVEL_ONE_PARKOUR, LEVEL_TWO_PARKOUR, LEVEL_THREE_PARKOUR, LEVEL_FOUR_PARKOUR } from '../Level/index.js';
import WORLD_RULES from '../world/worldrules.json';
import { buildObservatoryLevel5, updateObservatoryLevel5 } from './ObservatoryLevel5.js';

const QUEST_TYPES = ['quest:v3:level-1', 'quest:v3:level-2', 'quest:v3:level-3', 'quest:v3:level-4', 'quest:v3:level-5'];
const PROGRESS_KEY = 'paw-haven-level-progress-v3';
const LEGACY_PROGRESS_KEY = 'paw-haven-level-progress-v2';
const HOME = WORLD_RULES.playerSpawn || { x: -17.216117913318985, y: 0.0775, z: -4.682203776528315, yaw: 0 };

// Rapier 0.21 exposes a rigid body's colliders by index, not through body.colliders().
// Keep visual phase changes and collision changes on the same timed-board state.
function setRigidBodyCollidersEnabled(body, enabled) {
  if (!body || typeof body.numColliders !== 'function' || typeof body.collider !== 'function') return 0;
  let changed = 0;
  try {
    const count = body.numColliders();
    for (let index = 0; index < count; index++) {
      const collider = body.collider(index);
      if (!collider) continue;
      collider.setEnabled(Boolean(enabled));
      changed++;
    }
  } catch (error) {
    console.warn('Could not update a timed platform collider.', error);
  }
  return changed;
}

function setTimedChoiceBoardEnabled(record, enabled) {
  const motion = record?.group?.userData?.boardMotion;
  if (!motion?.choiceState) return;
  const active = Boolean(enabled);
  setRigidBodyCollidersEnabled(record.body, active);
  motion.choiceEnabled = active;

  const mesh = motion.choiceMesh;
  if (!mesh) return;
  mesh.visible = active;
  if (mesh.material) {
    mesh.material.opacity = active ? 0.96 : 0;
    mesh.material.emissiveIntensity = active ? 1.15 : 0.12;
    mesh.material.color.set(active ? '#c7a8ff' : '#756a91');
    mesh.material.emissive.set(active ? '#8a56e8' : '#302543');
  }
}

export class LevelSystem {
  constructor(game, scene, shelter) {
    this.game = game;
    this.scene = scene;
    this.shelter = shelter;
    this.basePhysics = game.physics;
    this.activePhysics = null;
    this.activeArena = null;
    this.activeLevel = null;
    this.questObject = null;
    this.special = null;
    this.checkpointGroups = [];
    this.checkpointIndex = 0;
    this.parkourRespawnPoint = null;
    this.finishTriggerLatched = false;
    this.hiddenPickupRoots = [];
    this.transitioning = false;
    this.disposed = false;
    this.elapsed = 0;
    this.currentPrompt = '';
    this.completed = new Set();
    this.pawTokens = 0;
    this.parkourBonusV2Applied = false;
    this.parkourLevel2BonusApplied = false;
    this.parkourLevel2RewardRecoveryApplied = false;
    this.rewarded = new Set();
    this.unlockedBadges = new Set();
    this.unlockedRewards = new Set();
    this.gateCollider = null;
    this.gateVisual = this.shelter.root.getObjectByName('LevelGateVisual');
    try {
      const currentRaw = localStorage.getItem(PROGRESS_KEY);
      const saved = JSON.parse(currentRaw || '{}');
      const legacy = currentRaw ? {} : JSON.parse(localStorage.getItem(LEGACY_PROGRESS_KEY) || '{}');
      // Keep earned currency across the new mission season, but replay redesigned levels.
      if (Array.isArray(saved.completed)) {
        for (const id of saved.completed) if (Number.isInteger(id) && id >= 1 && id <= 5) this.completed.add(id);
      }
      const savedCurrency = Number.isSafeInteger(saved.pawTokens) && saved.pawTokens >= 0
        ? saved.pawTokens
        : Number.isSafeInteger(legacy.pawTokens) && legacy.pawTokens >= 0 ? legacy.pawTokens : 0;
      this.pawTokens = savedCurrency;
      if (Array.isArray(saved.rewarded)) {
        for (const id of saved.rewarded) if (Number.isInteger(id) && id >= 1 && id <= 5) this.rewarded.add(id);
      }
      if (Array.isArray(saved.unlockedBadges)) {
        for (const badge of saved.unlockedBadges) if (typeof badge === 'string') this.unlockedBadges.add(badge);
      }
      if (Array.isArray(saved.unlockedRewards)) {
        for (const reward of saved.unlockedRewards) if (typeof reward === 'string') this.unlockedRewards.add(reward);
      }
      this.parkourBonusV2Applied = saved.parkourBonusV2Applied === true;
      this.parkourLevel2BonusApplied = saved.parkourLevel2BonusApplied === true;
      this.parkourLevel2RewardRecoveryApplied = saved.parkourLevel2RewardRecoveryApplied === true;
    } catch { /* Start with empty quest progress if storage is unavailable. */ }
    this.game.pawTokens = this.pawTokens;
    this.game.levelBadges = [...this.unlockedBadges];
    this.game.levelUnlocks = [...this.unlockedRewards];
    this.updateRewardHUD();
    this.installGateCollider();
    this.refreshGate();
    this.refreshGiftRequirement();
  }

  installGateCollider() {
    if (!this.basePhysics?.world || this.gateCollider || this.completed.size >= LEVELS.length) return;
    try {
      const desc = this.basePhysics.api.ColliderDesc.cuboid(0.07, 1.36, 0.73)
        .setTranslation(-15.65, 1.4, 10.265)
        .setFriction(0.8);
      this.gateCollider = this.basePhysics.world.createCollider(desc, this.basePhysics.fixedBody);
    } catch (error) {
      console.warn('Could not install the level gate collider.', error);
    }
  }

  refreshGate() {
    const open = this.completed.size >= LEVELS.length;
    if (this.gateVisual) {
      this.gateVisual.visible = !open;
      this.gateVisual.traverse((object) => { if (object.isMesh) object.visible = !open; });
    }
    if (open && this.gateCollider && this.basePhysics?.world) {
      try { this.basePhysics.world.removeCollider(this.gateCollider, true); } catch { /* The base world may already be disposing. */ }
      this.gateCollider = null;
    } else if (!open) {
      this.installGateCollider();
    }
  }

  updateRewardHUD() {
    const tokenLabel = document.getElementById('paw-token-balance');
    if (tokenLabel) tokenLabel.textContent = String(this.pawTokens);
    const badgeLabel = document.getElementById('level-badge-count');
    if (badgeLabel) badgeLabel.textContent = String(this.unlockedBadges.size);
    const rewardStatus = document.getElementById('level-reward-status');
    if (rewardStatus) {
      rewardStatus.title = this.unlockedRewards.size
        ? 'Unlocked: ' + [...this.unlockedRewards].join(', ')
        : 'Complete levels to earn trails and badges.';
    }
  }

  saveProgress() {
    try {
      localStorage.setItem(PROGRESS_KEY, JSON.stringify({
        completed: [...this.completed].sort((a, b) => a - b),
        pawTokens: this.pawTokens,
        rewarded: [...this.rewarded].sort((a, b) => a - b),
        parkourBonusV2Applied: this.parkourBonusV2Applied,
        parkourLevel2BonusApplied: this.parkourLevel2BonusApplied,
        parkourLevel2RewardRecoveryApplied: this.parkourLevel2RewardRecoveryApplied,
        unlockedBadges: [...this.unlockedBadges].sort(),
        unlockedRewards: [...this.unlockedRewards].sort()
      }));
    } catch { /* The current session still keeps progress in memory. */ }
  }

  refreshGiftRequirement() {
    const inventory = this.game.inventory;
    const dog = this.game.dog;
    // Completing a level counts toward the gift quest even if its souvenir could not fit in the inventory.
    dog.levelQuestReady = QUEST_TYPES.every((token, index) =>
      Boolean(inventory?.hasQuestItems?.([token])) || this.completed.has(index + 1)
    );
    const position = dog?.group?.position;
    if (dog.levelQuestReady && position
      && Math.hypot(position.x - 0.4091122236594593, position.z - 7.668321010529183) < 0.88) {
      dog.levelGiftTriggerActivated = true;
    }
  }

  update(dt) {
    if (this.disposed || this.transitioning) return;
    this.refreshGiftRequirement();

    if (this.activeLevel) {
      this.updateArena(dt);
      return;
    }

    const position = this.game.dog?.group?.position;
    if (!position) return;

    for (const level of LEVELS) {
      if (Math.abs(position.x - level.trigger.x) > level.trigger.rx
        || Math.abs(position.z - level.trigger.z) > level.trigger.rz) continue;

      // All five levels remain replayable. Completion and reward flags prevent
      // duplicate rewards, so an existing quest token must not block arena entry.
      this.enterLevel(level);
      break;
    }
  }

  async enterLevel(level) {
    if (this.transitioning || this.disposed || !this.basePhysics) return;
    this.transitioning = true;
    let arena = null;
    let physics = null;
    try {
      arena = this.buildArena(level);
      physics = await PhysicsWorld.create(arena.solids);
      const kinematicType = physics.api.RigidBodyType.KinematicPositionBased;
      for (const record of physics.dynamicProps || []) {
        if (!record.body) continue;
        const boardMotion = record.group?.userData?.boardMotion;
        const spinMotion = record.group?.userData?.spinMotion;
        if (!boardMotion && !spinMotion) continue;
        record.body.setBodyType(kinematicType, true);
        record.body.setGravityScale(0, true);
        record.body.setLinvel({ x: 0, y: 0, z: 0 }, true);
        record.body.setAngvel({ x: 0, y: 0, z: 0 }, true);
        if (boardMotion?.choiceState) setTimedChoiceBoardEnabled(record, false);
        if (spinMotion) {
          const half = spinMotion.currentAngle * 0.5;
          record.body.setRotation({ x: 0, y: Math.sin(half), z: 0, w: Math.cos(half) }, true);
          record.body.setNextKinematicRotation?.({ x: 0, y: Math.sin(half), z: 0, w: Math.cos(half) });
        }
      }
      if (this.disposed) {
        physics.dispose();
        this.disposeArena(arena.group);
        return;
      }
      this.activeArena = arena.group;
      this.activePhysics = physics;
      this.activeLevel = level;
      this.questObject = arena.questObject;
      this.animatedMechanic = arena.animatedMechanic || null;
      this.animatedMechanic2 = arena.animatedMechanic2 || null;
      this.special = arena.special || null;
      this.checkpointGroups = arena.checkpointGroups || [];
      this.checkpointIndex = 0;
      this.finishTriggerLatched = false;
      this.elapsed = 0;
      this.scene.add(arena.group);
      this.shelter.root.visible = false;
      this.hiddenPickupRoots = [];
      for (const item of this.game.inventory?.items || []) {
        if (!item.root) continue;
        this.hiddenPickupRoots.push({ root: item.root, visible: item.root.visible });
        item.root.visible = false;
      }
      if (this.game.inventory?.ringIdleMesh) this.game.inventory.ringIdleMesh.visible = false;
      if (this.game.inventory?.ringActiveMesh) this.game.inventory.ringActiveMesh.visible = false;
      this.game.physics = physics;
      this.game.movement.physics = physics;
      this.game.movement.setWorldBounds?.(level.id === 3
        ? { minX: -27.2, maxX: 27.2, minZ: -34.0, maxZ: 34.0 }
        : level.id === 4
          ? { minX: -20.0, maxX: 20.0, minZ: -34.0, maxZ: 45.0 }
          : level.id === 5
            ? { minX: -16.5, maxX: 16.5, minZ: -46.0, maxZ: 138.0 }
            : null);
      this.game.inventory.physics = physics;
      this.game.inventory.levelMode = true;
      const parkourCourse = PARKOUR_COURSES[level.id] || null;
      this.parkourRespawnPoint = parkourCourse ? { ...parkourCourse.spawn } : null;
      this.moveDogTo(parkourCourse ? parkourCourse.spawn : { x: 0, y: 0.0775, z: -7.5 }, physics);
      this.game.resetRenderPositionSnapshots?.();
      this.game.cameraRig.worldRoot = arena.group;
      this.game.cameraRig.cacheCameraOccluders();
      this.game.cameraRig.resetView(this.game.dog?.group?.position);
      this.setPrompt('Level ' + level.id + ': ' + level.name + '. ' + level.mechanicIntro);
    } catch (error) {
      console.error('Failed to open level arena:', error);
      if (physics) physics.dispose();
      if (arena?.group) this.disposeArena(arena.group);
      this.activeArena = null;
      this.activePhysics = null;
      this.activeLevel = null;
      this.questObject = null;
      this.animatedMechanic = null;
      this.animatedMechanic2 = null;
      this.special = null;
      this.checkpointGroups = [];
      this.checkpointIndex = 0;
      this.parkourRespawnPoint = null;
      this.finishTriggerLatched = false;
      this.game.physics = this.basePhysics;
      this.game.movement.physics = this.basePhysics;
      this.game.movement.setWorldBounds?.(null);
      this.game.inventory.physics = this.basePhysics;
      this.game.inventory.levelMode = false;
      for (const saved of this.hiddenPickupRoots) if (saved.root) saved.root.visible = saved.visible;
      this.hiddenPickupRoots = [];
      if (this.game.inventory?.ringIdleMesh) this.game.inventory.ringIdleMesh.visible = true;
      if (this.game.inventory?.ringActiveMesh) this.game.inventory.ringActiveMesh.visible = true;
      this.shelter.root.visible = true;
      this.moveDogTo(HOME, this.basePhysics);
      this.game.cameraRig.worldRoot = this.shelter.root;
      this.game.cameraRig.cacheCameraOccluders();
      this.game.cameraRig.resetView(this.game.dog?.group?.position);
      this.game.resetRenderPositionSnapshots?.();
      this.setPrompt('Arena level gagal dibuka. Coba dekati pintu lagi.');
    } finally {
      this.transitioning = false;
    }
  }


  updateArena(dt) {
    const position = this.game.dog?.group?.position;
    const level = this.activeLevel;
    if (!position || !level) return;

    const course = PARKOUR_COURSES[level.id] || null;
    const stepDt = Math.min(0.05, Math.max(0, Number(dt) || 0));
    this.elapsed += stepDt;
    this.syncBoardRiders(position);

    if (this.questObject) {
      const finish = course?.platforms.find((platform) => platform.finish);
      this.questObject.rotation.y += stepDt * 0.9;
      this.questObject.position.y = (finish ? finish.top + 0.48 : 0.52)
        + Math.sin(this.elapsed * 2.8) * 0.06;
      this.questObject.children[0]?.rotation.set(
        this.elapsed * 0.3,
        this.elapsed * 0.7,
        this.elapsed * 0.2
      );
    }
    if (this.animatedMechanic) {
      this.animatedMechanic.rotation.y += stepDt
        * (level.id === 1 ? 3.5 : level.id === 2 ? 2.8 : level.id === 5 ? 0.85 : 0.42);
    }
    if (this.animatedMechanic2) this.animatedMechanic2.rotation.y -= stepDt * 2.35;

    // The shelter return portal is independent from the finish pressure plate.
    const returnZ = level.id === 5 ? -44.0 : level.id === 4 ? -32.8 : level.id === 3 ? -32.4 : -9.5;
    if (Math.hypot(position.x, position.z - returnZ) < (level.id === 3 || level.id === 4 || level.id === 5 ? 1.0 : 0.88)) {
      this.returnHome(false);
      return;
    }

    // Respawn only when K-09 is actually grounded below the parkour route.
    if (course && this.game.movement?.grounded && position.y <= 0.18) {
      const inFallZone = level.id === 5
        ? position.z > -43.0 && position.z < 134.0
        : level.id === 4
          ? position.z > -31.5 && position.z < 45.2
          : level.id === 3
            ? position.z > -31.5 && position.z < 31.0
            : position.z > -9.35 && position.z < 9.8;
      if (inFallZone) {
        const safe = course.platforms.some((platform) =>
          Math.abs(position.x - platform.x) <= platform.width * 0.5 - 0.06
          && Math.abs(position.z - platform.z) <= platform.depth * 0.5 - 0.06
          && Math.abs(position.y - platform.top) <= 0.22
        );
        if (!safe) {
          this.moveDogTo(this.parkourRespawnPoint || course.spawn, this.activePhysics);
          this.game.resetRenderPositionSnapshots?.();
          this.setPrompt('K-09 jatuh! Kembali ke checkpoint terakhir. Coba lagi.');
          return;
        }
      }
    }

    // Update a special mechanic, but do not let it stop checkpoint or finish processing.
    // Its return value only means that its own objective is still active.
    const mechanicBusy = this.updateSpecialMechanic(level, position, stepDt);
    const plate = this.activeArena?.userData?.finishPressurePlate;
    let objectivesReady = false;

    if (plate) {
      const point = plate.userData.finishPoint || {
        x: plate.position.x,
        y: plate.position.y,
        z: plate.position.z
      };
      const zone = plate.userData.zone || {};
      const zoneX = Number.isFinite(zone.x) ? zone.x : point.x;
      const zoneZ = Number.isFinite(zone.z) ? zone.z : point.z;
      const finishPlatform = course?.platforms.find((platform) => platform.finish);
      // Use the full finish deck plus K-09's footprint, not a narrow centre-only point.
      // For puzzle arenas, include the visible plate and the chassis/paw reach.
      const zoneRX = Math.max(
        Number.isFinite(zone.rx) ? zone.rx : 1.05,
        finishPlatform ? finishPlatform.width * 0.5 + 0.34 : 1.28
      );
      const zoneRZ = Math.max(
        Number.isFinite(zone.rz) ? zone.rz : 0.95,
        finishPlatform ? finishPlatform.depth * 0.5 + 0.34 : 1.08
      );

      const requireCheckpoints = level.finishRequirements?.checkpoints !== false;
      const requireMechanic = level.finishRequirements?.mechanic === true;
      const checkpointsReady = !requireCheckpoints
        || this.checkpointIndex >= this.checkpointGroups.length;
      const mechanicReady = !requireMechanic || this.special?.completed === true;
      objectivesReady = checkpointsReady && mechanicReady;

      const heightDelta = Math.abs(position.y - point.y);
      const verticalVelocity = Number(
        this.game.movement?.verticalVelocity
        ?? this.game.dog?.verticalVelocity
        ?? 0
      );
      const grounded = this.game.movement?.grounded === true
        || this.game.dog?.grounded === true;
      const footContacts = this.game.dog?.footContacts || [];
      const footSupportedAtFinish = footContacts.some((contact) =>
        contact?.hasSurface === true
        && contact.blocked !== true
        && Number.isFinite(contact.currentY)
        && Math.abs(contact.currentY - point.y) <= 0.48
      );
      const stable = grounded || footSupportedAtFinish
        || (heightDelta <= 0.24 && Math.abs(verticalVelocity) <= 0.55);
      const inside = Math.abs(position.x - zoneX) <= zoneRX
        && Math.abs(position.z - zoneZ) <= zoneRZ;
      const surfaceTolerance = course ? 1.05 : 0.88;
      const pressed = inside && stable && heightDelta <= surfaceTolerance;
      const activating = pressed && objectivesReady;

      plate.userData.pressed = pressed;
      plate.userData.ready = objectivesReady;
      plate.userData.inside = inside;
      plate.userData.grounded = stable;
      plate.userData.heightDelta = heightDelta;
      plate.userData.blockReason = !checkpointsReady
        ? 'checkpoint'
        : !mechanicReady ? 'mechanic' : !inside ? 'position' : !stable ? 'grounded' : null;

      if (inside && !objectivesReady) {
        const lockMessage = !checkpointsReady
          ? 'FINISH terkunci: aktifkan checkpoint ' + Math.min(this.checkpointIndex + 1, this.checkpointGroups.length)
            + '/' + this.checkpointGroups.length + ' terlebih dahulu.'
          : 'FINISH terkunci: selesaikan mekanik utama Level ' + level.id + ' terlebih dahulu.';
        this.setPrompt(lockMessage);
      } else if (inside && objectivesReady && !stable) {
        this.setPrompt('Mendarat dan diam sejenak di PRESSURE PLATE untuk menyelesaikan Level ' + level.id + '.');
      }

      // Require a continuous press. Walking away or jumping off cancels the timer.
      if (activating) {
        if (!plate.userData.pendingActivation) {
          plate.userData.pendingActivation = true;
          plate.userData.pressElapsed = 0;
        }
        plate.userData.pressElapsed = Math.min(
          0.25,
          (plate.userData.pressElapsed || 0) + stepDt
        );
      } else {
        plate.userData.pendingActivation = false;
        plate.userData.pressElapsed = 0;
      }

      const visualPressed = activating && plate.userData.pendingActivation === true;
      if (plate.userData.plate) {
        const targetY = visualPressed
          ? plate.userData.platePressedY
          : plate.userData.plateRestY;
        plate.userData.plate.position.y = THREE.MathUtils.damp(
          plate.userData.plate.position.y,
          targetY,
          visualPressed ? 32 : 18,
          stepDt
        );
      }

      const visualState = (objectivesReady ? 'ready' : 'locked')
        + (visualPressed ? '-pressed' : '-rest');
      if (plate.userData.visualState !== visualState) {
        plate.userData.visualState = visualState;
        const mat = plate.userData.plateMaterial;
        if (mat) {
          mat.color.set(visualPressed ? '#fff4b5' : objectivesReady ? level.bright : '#7193a2');
          mat.emissive.set(visualPressed ? '#e4b94e' : objectivesReady ? level.color : '#2b5366');
          mat.emissiveIntensity = visualPressed ? 1.1 : objectivesReady ? 0.32 : 0.16;
        }
        for (const led of plate.userData.statusLeds || []) {
          led.material.color.set(visualPressed ? '#fff8d4' : objectivesReady ? '#ffe99a' : '#7193a2');
          led.material.emissive.set(visualPressed ? '#ffdf65' : objectivesReady ? '#b58d37' : '#2b5366');
          led.material.emissiveIntensity = visualPressed ? 1.5 : objectivesReady ? 0.72 : 0.22;
        }
      }

      if (plate.userData.pendingActivation
        && plate.userData.pressElapsed >= 0.12
        && !this.finishTriggerLatched) {
        this.finishTriggerLatched = true;
        if (this.completeLevel(level)) return;
        this.finishTriggerLatched = false;
        plate.userData.pendingActivation = false;
        plate.userData.pressElapsed = 0;
      }
    }

    // Checkpoints remain usable while a special objective is active. This prevents
    // the mechanic update loop from starving the rest of the Level state machine.
    if (this.checkpointIndex < this.checkpointGroups.length) {
      const marker = this.checkpointGroups[this.checkpointIndex];
      const target = marker?.userData?.point;
      if (!target) return;

      const checkpointDistance = Math.hypot(
        position.x - target.x,
        position.z - target.z
      );
      const checkpointHeightReady = ![4, 5].includes(level.id)
        || !Number.isFinite(target.y)
        || Math.abs(position.y - target.y) <= 0.62;
      if (checkpointDistance >= 1.30 || !checkpointHeightReady) {
        if (!mechanicBusy) {
          this.setPrompt(
            checkpointDistance < 1.30 && !checkpointHeightReady
              ? 'Naik ke platform ' + (level.checkpointLabel || 'checkpoint') + ' ' + (this.checkpointIndex + 1) + ' untuk mengaktifkannya.'
              : 'Level ' + level.id + ': dekati '
                + (level.checkpointLabel || 'checkpoint') + ' '
                + (this.checkpointIndex + 1) + '/' + this.checkpointGroups.length + '.'
          );
        }
        return;
      }

      // Checkpoints activate on grounded contact. Requiring an extra INTERACT press
      // made the finish feel broken when players had physically crossed the beacon.
      const checkpointGrounded = this.game.movement?.grounded === true
        || this.game.dog?.grounded === true
        || (this.game.dog?.footContacts || []).some((contact) =>
          contact?.hasSurface === true && contact.blocked !== true
        );
      if (!checkpointGrounded) {
        this.setPrompt('Mendarat di ' + (level.checkpointLabel || 'checkpoint') + ' untuk mengaktifkannya.');
        return;
      }

      marker.visible = false;
      this.checkpointIndex += 1;
      if (course && Number.isFinite(target.y)) {
        this.parkourRespawnPoint = {
          x: target.x,
          y: target.y + 0.025,
          z: target.z,
          yaw: Math.PI
        };
      }

      const next = this.checkpointGroups[this.checkpointIndex];
      if (next) next.visible = true;
      else if (this.questObject && !course) this.questObject.visible = true;

      this.setPrompt(this.checkpointIndex < this.checkpointGroups.length
        ? 'Checkpoint ' + this.checkpointIndex + '/' + this.checkpointGroups.length
          + ' aktif. Lanjut ke beacon berikutnya.'
        : 'Semua checkpoint aktif! Injak PRESSURE PLATE di FINISH.');
      return;
    }

    // Keep the mechanic's current instruction visible while it is still incomplete.
    if (mechanicBusy && !objectivesReady) return;

    this.setPrompt(objectivesReady
      ? 'Semua objektif selesai. Injak PRESSURE PLATE di FINISH untuk mengakhiri Level ' + level.id + '.'
      : 'Selesaikan mekanik utama level sebelum menuju FINISH.');
  }
  completeLevel(level) {
    if (!level || this.transitioning || this.activeLevel?.id !== level.id) return false;
    const granted = this.game.inventory?.grantQuestItem?.(level.token) ?? false;
    const reward = level.reward || { pawTokens: 0, badge: 'Explorer' };
    const firstReward = !this.rewarded.has(level.id);
    let recoveredLegacyLevelTwoReward = false;

    if (firstReward) {
      this.pawTokens += reward.pawTokens || 0;
      this.rewarded.add(level.id);
      if (reward.badge) this.unlockedBadges.add(reward.badge);
      if (reward.unlock) this.unlockedRewards.add(reward.unlock);
    }
    if (level.id === 2 && !this.parkourLevel2RewardRecoveryApplied) {
      if (!firstReward) {
        this.pawTokens += reward.pawTokens || 0;
        if (reward.badge) this.unlockedBadges.add(reward.badge);
        if (reward.unlock) this.unlockedRewards.add(reward.unlock);
        recoveredLegacyLevelTwoReward = true;
      }
      this.parkourLevel2RewardRecoveryApplied = true;
    }
    let bonus = 0;
    if (level.id === 1 && !this.parkourBonusV2Applied) {
      if (!firstReward) { bonus = 25; this.pawTokens += bonus; }
      this.parkourBonusV2Applied = true;
    }
    if (level.id === 2 && !this.parkourLevel2BonusApplied) {
      if (!firstReward && !recoveredLegacyLevelTwoReward) { bonus = 75; this.pawTokens += bonus; }
      this.parkourLevel2BonusApplied = true;
    }

    this.game.pawTokens = this.pawTokens;
    this.game.levelBadges = [...this.unlockedBadges];
    this.game.levelUnlocks = [...this.unlockedRewards];
    this.updateRewardHUD();
    this.completed.add(level.id);
    this.saveProgress();
    this.refreshGate();
    this.refreshGiftRequirement();

    const rewardText = recoveredLegacyLevelTwoReward
      ? 'Pemulihan hadiah +' + (reward.pawTokens || 0) + ' Paw Tokens, lencana ' + reward.badge + ' dan unlock ' + (reward.unlock || 'Explorer') + '.'
      : firstReward
        ? 'Hadiah +' + (reward.pawTokens || 0) + ' Paw Tokens, lencana ' + reward.badge + ' dan unlock ' + (reward.unlock || 'Explorer') + '.'
        : bonus > 0
          ? 'Bonus selisih hadiah +' + bonus + ' Paw Tokens.'
          : 'Lencana ' + reward.badge + ' sudah pernah diperoleh.';
    this.lastRewardMessage = 'Misi Level ' + level.id + ' selesai! ' + rewardText
      + (granted ? '' : ' Tas penuh, tetapi progres dan hadiah tetap dicatat.')
      + ' Saldo: ' + this.pawTokens + ' Paw Tokens. K-09 kembali ke shelter.';
    this.returnHome(true);
    this.setPrompt(this.lastRewardMessage);
    return true;
  }

  preparePhysics(dt) {
    if (this.transitioning || ![3, 4, 5].includes(this.activeLevel?.id)) return;
    const records = this.activePhysics?.dynamicProps || [];
    const dogPosition = this.game.dog?.group?.position;
    if (!dogPosition) return;
    const step = Math.min(0.05, Math.max(0, Number(dt) || 0));
    const motionTick = (this.platformMotionTick || 0) + 1;
    this.platformMotionTick = motionTick;
    const movement = this.game.movement;
    let ridingPlatform = false;

    const chooseSide = (state) => {
      let side = Math.random() < 0.5 ? -1 : 1;
      if (side === state.lastSide && Math.random() < 0.35) side = -side;
      return side;
    };

    for (const record of records) {
      if (!record.body) continue;
      const motion = record.group?.userData?.boardMotion;
      const spin = record.group?.userData?.spinMotion;

      if (motion) {
        const state = motion.choiceState;
        if (state && state.lastUpdatedTick !== motionTick) {
          state.lastUpdatedTick = motionTick;
          const distanceToTrigger = Math.hypot(
            dogPosition.x - state.trigger.x,
            dogPosition.z - state.trigger.z
          );

          if (!state.started && distanceToTrigger <= state.radius) {
            state.started = true;
            state.activeSide = chooseSide(state);
            state.remaining = state.duration;
          } else if (state.started) {
            state.remaining = Math.max(0, state.remaining - step);
            if (state.remaining <= 0) {
              if (state.activeSide !== null) {
                state.lastSide = state.activeSide;
                state.activeSide = null;
                state.remaining = state.cooldown;
              } else {
                state.activeSide = chooseSide(state);
                state.remaining = state.duration;
              }
            }
          }
        }

        if (state) {
          const enabled = state.activeSide === motion.choiceSide;
          if (motion.choiceEnabled !== enabled) setTimedChoiceBoardEnabled(record, enabled);
        }

        const previousX = motion.currentRenderX ?? motion.baseX;
        const previousZ = motion.currentRenderZ ?? motion.baseZ;
        motion.previousRenderX = previousX;
        motion.previousRenderZ = previousZ;
        motion.elapsed = (motion.elapsed || 0) + step;
        const offset = Math.sin(motion.elapsed * motion.speed + motion.phase) * motion.range;
        motion.currentRenderX = motion.baseX + (motion.axis === 'x' ? offset : 0);
        motion.currentRenderZ = motion.baseZ + (motion.axis === 'z' ? offset : 0);
        const dx = motion.currentRenderX - previousX;
        const dz = motion.currentRenderZ - previousZ;

        const footSupported = (this.game.dog?.footContacts || []).some((contact) =>
          contact?.hasSurface === true
          && contact.blocked !== true
          && Number.isFinite(contact.currentY)
          && Math.abs(contact.currentY - motion.top) <= 0.28
        );
        const boardActive = !state || state.activeSide === motion.choiceSide;
        const rider = boardActive
          && (movement?.grounded === true || footSupported)
          && Math.abs(dogPosition.y - motion.top) <= 0.30
          && Math.abs(dogPosition.x - previousX) <= motion.width * 0.5 + 0.20
          && Math.abs(dogPosition.z - previousZ) <= motion.spanZ * 0.5 + 0.20;

        if (rider) {
          ridingPlatform = true;
          dogPosition.x += dx;
          dogPosition.z += dz;
          this.activePhysics.setPosition({
            x: dogPosition.x,
            y: dogPosition.y + 0.78,
            z: dogPosition.z
          });
          if (movement?.platformCarryVelocity) {
            movement.platformCarryVelocity.x = step > 1e-5 ? THREE.MathUtils.clamp(dx / step, -2.4, 2.4) : 0;
            movement.platformCarryVelocity.z = step > 1e-5 ? THREE.MathUtils.clamp(dz / step, -2.4, 2.4) : 0;
          }
        }

        record.body.setNextKinematicTranslation({
          x: motion.currentRenderX,
          y: record.prop.origin.y,
          z: motion.currentRenderZ
        });
      }

      if (spin) {
        spin.previousAngle = spin.currentAngle;
        spin.elapsed = (spin.elapsed || 0) + step;
        spin.currentAngle = spin.phase + spin.elapsed * spin.speed;
        const half = spin.currentAngle * 0.5;
        record.body.setNextKinematicRotation({
          x: 0,
          y: Math.sin(half),
          z: 0,
          w: Math.cos(half)
        });
      }
    }
    if (!ridingPlatform && movement?.grounded && movement.platformCarryVelocity) {
      movement.platformCarryVelocity.set(0, 0, 0);
    }
  }

