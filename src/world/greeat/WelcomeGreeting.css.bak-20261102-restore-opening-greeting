/* Compact Level 1 welcome card. It never dims or blocks the 3D world. */
.level-one-greeting{
  position:absolute;
  inset:0;
  z-index:9;
  pointer-events:none;
}
.level-one-greeting__card{
  position:absolute;
  top:calc(72px + env(safe-area-inset-top));
  left:clamp(10px,2vw,22px);
  width:min(350px,calc(100vw - 24px));
  display:grid;
  grid-template-columns:40px minmax(0,1fr);
  grid-template-rows:minmax(0,1fr) auto;
  gap:7px 10px;
  padding:11px 12px 10px;
  border:1px solid rgba(214,239,218,.28);
  border-radius:14px;
  background:rgba(8,29,35,.88);
  box-shadow:0 8px 22px rgba(0,0,0,.22);
  color:#f4fff7;
  pointer-events:auto;
  animation:level-one-greeting-in .18s ease-out both;
}
.level-one-greeting__mark{
  grid-column:1;
  grid-row:1 / span 2;
  align-self:center;
  display:grid;
  place-items:center;
  width:38px;
  height:38px;
  border:1px solid rgba(200,243,106,.38);
  border-radius:11px;
  background:rgba(200,243,106,.12);
  color:#c8f36a;
  font-size:21px;
}
.level-one-greeting__copy{grid-column:2;grid-row:1;min-width:0}
.level-one-greeting__eyebrow{
  display:block;
  margin-bottom:4px;
  color:#c8f36a;
  font:800 7px/1.3 Manrope,system-ui,sans-serif;
  letter-spacing:.12em;
}
.level-one-greeting__copy h2{
  margin:0 0 4px;
  color:#f7fff8;
  font:800 14px/1.2 Manrope,system-ui,sans-serif;
}
.level-one-greeting__copy p{
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  overflow:hidden;
  margin:0;
  color:#c7ddd0;
  font:500 10px/1.45 'DM Sans',system-ui,sans-serif;
}
.level-one-greeting__start{
  grid-column:2;
  grid-row:2;
  justify-self:end;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  min-width:104px;
  min-height:32px;
  padding:7px 12px;
  border:1px solid rgba(222,248,165,.75);
  border-radius:9px;
  background:#c8f36a;
  color:#123b37;
  font:900 8px Manrope,system-ui,sans-serif;
  letter-spacing:.1em;
  cursor:pointer;
}
.level-one-greeting__start:active{transform:translateY(1px)}
.level-one-greeting__start:focus-visible{
  outline:2px solid #fff;
  outline-offset:3px;
}
#game.level-one-greeting-active .mission-card{visibility:hidden;pointer-events:none}
@keyframes level-one-greeting-in{
  from{opacity:0;transform:translateY(-5px)}
  to{opacity:1;transform:translateY(0)}
}
@media(max-width:600px){
  .level-one-greeting__card{
    top:calc(60px + env(safe-area-inset-top));
    left:10px;
    width:min(340px,calc(100vw - 20px));
    padding:9px 10px 8px;
    grid-template-columns:34px minmax(0,1fr);
    gap:5px 8px;
    border-radius:12px;
  }
  .level-one-greeting__mark{width:32px;height:32px;font-size:18px}
  .level-one-greeting__eyebrow{font-size:6px}
  .level-one-greeting__copy h2{font-size:12px}
  .level-one-greeting__copy p{font-size:9px;line-height:1.4}
  .level-one-greeting__start{min-width:92px;min-height:29px;padding:6px 10px;font-size:7px}
}
@media(orientation:landscape) and (max-height:560px){
  .level-one-greeting__card{
    top:calc(58px + env(safe-area-inset-top));
    padding:8px 10px 7px;
    gap:4px 8px;
  }
}
@media(prefers-reduced-motion:reduce){
  .level-one-greeting__card{animation:none}
}
