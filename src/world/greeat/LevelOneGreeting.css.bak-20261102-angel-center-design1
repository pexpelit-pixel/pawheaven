/* Level 1 welcome card: visible over the cinematic without hiding the 3D scene. */
.level-one-greeting{
  position:absolute;
  inset:0;
  z-index:30;
  pointer-events:none;
}
.level-one-greeting__card{
  position:absolute;
  top:calc(72px + env(safe-area-inset-top));
  left:clamp(10px,2vw,22px);
  width:min(402px,calc(100vw - 24px));
  display:grid;
  grid-template-columns:46px minmax(0,1fr);
  grid-template-rows:minmax(0,1fr) auto;
  gap:8px 11px;
  padding:13px 14px 12px;
  border:1px solid rgba(214,239,218,.30);
  border-radius:16px;
  background:rgba(8,29,35,.90);
  box-shadow:0 9px 24px rgba(0,0,0,.24);
  color:#f4fff7;
  pointer-events:auto;
  animation:level-one-greeting-in .18s ease-out both;
}
.level-one-greeting__mark{
  grid-column:1;
  grid-row:1 / span 2;
  align-self:center;
  display:grid;
  place-items:center;
  width:44px;
  height:44px;
  border:1px solid rgba(200,243,106,.38);
  border-radius:13px;
  background:rgba(200,243,106,.12);
  color:#c8f36a;
  font-size:24px;
}
.level-one-greeting__copy{grid-column:2;grid-row:1;min-width:0}
.level-one-greeting__eyebrow{
  display:block;
  margin-bottom:5px;
  color:#c8f36a;
  font:800 8px/1.3 Manrope,system-ui,sans-serif;
  letter-spacing:.12em;
}
.level-one-greeting__copy h2{
  margin:0 0 5px;
  color:#f7fff8;
  font:800 16px/1.2 Manrope,system-ui,sans-serif;
}
.level-one-greeting__copy p{
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  overflow:hidden;
  margin:0;
  color:#c7ddd0;
  font:500 11.5px/1.45 'DM Sans',system-ui,sans-serif;
}
.level-one-greeting__start{
  grid-column:2;
  grid-row:2;
  justify-self:end;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:14px;
  min-width:120px;
  min-height:37px;
  padding:8px 14px;
  border:1px solid rgba(222,248,165,.75);
  border-radius:10px;
  background:#c8f36a;
  color:#123b37;
  font:900 9px Manrope,system-ui,sans-serif;
  letter-spacing:.1em;
  cursor:pointer;
}
.level-one-greeting__start:active{transform:translateY(1px)}
.level-one-greeting__start:focus-visible{
  outline:2px solid #fff;
  outline-offset:3px;
}
#game.level-one-greeting-active .mission-card{visibility:hidden;pointer-events:none}
@keyframes level-one-greeting-in{
  from{opacity:0;transform:translateY(-5px)}
  to{opacity:1;transform:translateY(0)}
}
@media(max-width:600px){
  .level-one-greeting__card{
    left:10px;
    width:min(391px,calc(100vw - 20px));
    padding:11px 12px 10px;
    grid-template-columns:39px minmax(0,1fr);
    gap:6px 9px;
    border-radius:14px;
  }
  .level-one-greeting__mark{width:37px;height:37px;font-size:21px}
  .level-one-greeting__eyebrow{font-size:7px}
  .level-one-greeting__copy h2{font-size:14px}
  .level-one-greeting__copy p{font-size:10.5px;line-height:1.4}
  .level-one-greeting__start{min-width:106px;min-height:34px;padding:7px 12px;font-size:8px}
}
@media(orientation:landscape){
  .level-one-greeting__card{
    top:calc(25vh + env(safe-area-inset-top));
  }
}
@media(max-height:420px) and (orientation:landscape){
  .level-one-greeting__card{gap:5px 9px;padding-top:9px;padding-bottom:9px}
  .level-one-greeting__copy p{-webkit-line-clamp:2;font-size:10px}
}
@media(prefers-reduced-motion:reduce){
  .level-one-greeting__card{animation:none}
}
