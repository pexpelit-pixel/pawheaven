/* Angel's Welcome: centered horizontally, kept high so K-09 remains visible. */
.level-one-greeting{
  position:absolute;
  inset:0;
  z-index:30;
  pointer-events:none;
  display:block;
}
.level-one-greeting__card{
  position:absolute;
  top:auto;
  bottom:0;
  left:50%;
  transform:translateX(-50%);
  width:80vw;
  height:20vh;
  min-height:96px;
  box-sizing:border-box;
  display:grid;
  grid-template-columns:62px minmax(0,1fr) auto;
  grid-template-rows:1fr;
  align-items:center;
  gap:12px;
  padding:clamp(8px,2vh,14px) 10% 5%;
  overflow:hidden;
  border:1px solid rgba(255,255,255,.82);
  border-radius:22px;
  background:
    radial-gradient(ellipse at 8% 0%,rgba(255,255,255,.70),transparent 45%),
    linear-gradient(135deg,rgba(255,248,239,.70),rgba(255,231,238,.70) 52%,rgba(226,250,239,.70));
  box-shadow:0 12px 34px rgba(35,52,57,.20),inset 0 1px 0 rgba(255,255,255,.95);
  color:#42545a;
  pointer-events:auto;
  animation:level-one-greeting-in .42s cubic-bezier(.2,.8,.2,1) both;
}
.level-one-greeting__card::before,
.level-one-greeting__card::after{
  content:"";
  position:absolute;
  z-index:0;
  pointer-events:none;
  border:1px solid rgba(225,174,190,.38);
  border-radius:50%;
}
.level-one-greeting__card::before{
  width:118px;height:118px;right:-48px;top:-76px;
}
.level-one-greeting__card::after{
  width:76px;height:76px;left:-42px;bottom:-51px;
}
.level-one-greeting__mark{
  position:relative;
  z-index:1;
  display:grid;
  place-items:center;
  width:58px;
  height:58px;
  border:1px solid rgba(255,255,255,.95);
  border-radius:19px;
  background:linear-gradient(145deg,#fff,#ffe5ee 58%,#e1f8ec);
  box-shadow:0 5px 14px rgba(191,139,157,.18),inset 0 0 0 4px rgba(255,255,255,.48);
  color:#d78da7;
  font-size:29px;
  text-shadow:0 2px 8px rgba(215,141,167,.28);
}
.level-one-greeting__copy{
  position:relative;
  z-index:1;
  min-width:0;
}
.level-one-greeting__eyebrow{
  display:block;
  margin:0 0 5px;
  color:#b47b91;
  font:900 9px/1.25 Manrope,system-ui,sans-serif;
  letter-spacing:.15em;
}
.level-one-greeting__copy h2{
  margin:0 0 5px;
  color:#53656a;
  font:800 clamp(15px,1.55vw,19px)/1.15 Manrope,system-ui,sans-serif;
  letter-spacing:-.025em;
}
.level-one-greeting__copy p{
  display:-webkit-box;
  -webkit-box-orient:vertical;
  -webkit-line-clamp:2;
  overflow:hidden;
  margin:0;
  color:#718187;
  font:600 11px/1.42 'DM Sans',system-ui,sans-serif;
}
.level-one-greeting__start{
  position:relative;
  z-index:1;
  align-self:center;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  min-width:106px;
  min-height:40px;
  padding:9px 13px;
  border:1px solid rgba(255,255,255,.92);
  border-radius:13px;
  background:linear-gradient(135deg,#d8f3b4,#b9e7c9);
  box-shadow:0 5px 13px rgba(118,166,137,.20),inset 0 1px 0 rgba(255,255,255,.8);
  color:#496b5c;
  font:900 9px Manrope,system-ui,sans-serif;
  letter-spacing:.12em;
  white-space:nowrap;
  cursor:pointer;
  transition:transform .16s ease,box-shadow .16s ease,filter .16s ease;
}
.level-one-greeting__start:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 17px rgba(118,166,137,.25),inset 0 1px 0 rgba(255,255,255,.8);
  filter:saturate(1.08);
}
.level-one-greeting__start:active{transform:translateY(0) scale(.98)}
.level-one-greeting__start:focus-visible{
  outline:2px solid #9acbaf;
  outline-offset:3px;
}
#game.level-one-greeting-active .mission-card{visibility:hidden;pointer-events:none}
@keyframes level-one-greeting-in{
  from{opacity:0;transform:translate(-50%,-8px) scale(.98)}
  to{opacity:1;transform:translate(-50%,0) scale(1)}
}
@media(max-width:760px){
  .level-one-greeting__card{
    top:auto;
    bottom:0;
    width:80vw;
    height:20vh;
    min-height:88px;
    grid-template-columns:48px minmax(0,1fr);
    grid-template-rows:1fr auto;
    gap:7px 10px;
    padding:clamp(8px,1.5vh,12px) 10% 5%;
    border-radius:18px;
  }
  .level-one-greeting__mark{
    grid-column:1;grid-row:1 / span 2;
    width:46px;height:46px;border-radius:15px;font-size:24px;
  }
  .level-one-greeting__copy{grid-column:2;grid-row:1}
  .level-one-greeting__eyebrow{font-size:8px;margin-bottom:4px}
  .level-one-greeting__copy h2{font-size:15px}
  .level-one-greeting__copy p{font-size:10.5px}
  .level-one-greeting__start{
    grid-column:2;grid-row:2;justify-self:end;
    min-width:104px;min-height:34px;padding:7px 11px;font-size:8px;
  }
}
@media(orientation:landscape) and (max-height:480px){
  .level-one-greeting__card{
    top:auto;
    bottom:0;
    height:20vh;
    min-height:76px;
    padding:clamp(6px,1.4vh,9px) 10% 5%;
    gap:9px;
  }
  .level-one-greeting__mark{width:43px;height:43px;font-size:22px}
  .level-one-greeting__eyebrow{font-size:7px;margin-bottom:3px}
  .level-one-greeting__copy h2{font-size:14px;margin-bottom:3px}
  .level-one-greeting__copy p{font-size:9.5px;line-height:1.3}
  .level-one-greeting__start{min-height:32px;min-width:92px;font-size:8px}
}
@media(prefers-reduced-motion:reduce){
  .level-one-greeting__card{animation:none;transition:none}
  .level-one-greeting__start{transition:none}
}
