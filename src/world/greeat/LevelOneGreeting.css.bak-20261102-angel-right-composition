/* Simple green Level 1 greeting. */
.level-one-greeting{
  position:absolute;
  inset:0;
  z-index:30;
  display:block;
  pointer-events:none;
}
.level-one-greeting__card{
  position:absolute;
  left:10%;
  right:10%;
  bottom:0;
  height:20vh;
  min-height:96px;
  box-sizing:border-box;
  display:grid;
  grid-template-columns:clamp(42px,7vh,62px) minmax(0,1fr) auto;
  align-items:center;
  gap:12px;
  padding:clamp(8px,2vh,14px) 10% 5%;
  overflow:hidden;
  border:1px solid rgba(83,151,103,.42);
  border-bottom:0;
  border-radius:18px 18px 0 0;
  background:rgba(225,246,228,.70);
  box-shadow:0 -8px 22px rgba(32,91,49,.13);
  color:#244d32;
  pointer-events:auto;
  animation:level-one-greeting-in .3s ease-out both;
}
.level-one-greeting__angel{
  display:block;
  width:100%;
  max-width:62px;
  max-height:72px;
  height:100%;
  object-fit:contain;
  object-position:center bottom;
  user-select:none;
  -webkit-user-drag:none;
}
.level-one-greeting__copy{
  min-width:0;
}
.level-one-greeting__eyebrow{
  display:block;
  margin:0 0 4px;
  color:#43845a;
  font:800 8px/1.2 Manrope,system-ui,sans-serif;
  letter-spacing:.12em;
}
.level-one-greeting__copy h2{
  margin:0 0 4px;
  color:#245b38;
  font:800 clamp(14px,1.5vw,18px)/1.15 Manrope,system-ui,sans-serif;
}
.level-one-greeting__copy p{
  margin:0;
  color:#426b4d;
  font:600 11px/1.4 'DM Sans',system-ui,sans-serif;
}
.level-one-greeting__copy p.is-typing::after{
  content:"▍";
  display:inline-block;
  margin-left:2px;
  color:#2e8b57;
  animation:level-one-caret .75s steps(1,end) infinite;
}
.level-one-greeting__start{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  min-width:94px;
  min-height:38px;
  padding:8px 12px;
  border:0;
  border-radius:10px;
  background:#348653;
  color:#fff;
  box-shadow:0 3px 9px rgba(38,104,59,.18);
  font:800 9px Manrope,system-ui,sans-serif;
  letter-spacing:.1em;
  white-space:nowrap;
  cursor:pointer;
  transition:background .15s ease,transform .15s ease;
}
.level-one-greeting__start:hover{
  background:#287447;
  transform:translateY(-1px);
}
.level-one-greeting__start:active{transform:scale(.98)}
.level-one-greeting__start:focus-visible{
  outline:2px solid #2e8b57;
  outline-offset:3px;
}
#game.level-one-greeting-active .mission-card{visibility:hidden;pointer-events:none}
@keyframes level-one-greeting-in{
  from{opacity:0;transform:translateY(8px)}
  to{opacity:1;transform:translateY(0)}
}
@keyframes level-one-caret{
  50%{opacity:0}
}
@media(max-width:760px){
  .level-one-greeting__card{
    height:20vh;
    min-height:88px;
    grid-template-columns:42px minmax(0,1fr);
    grid-template-rows:1fr auto;
    gap:5px 10px;
    padding:clamp(8px,1.5vh,12px) 10% 5%;
    border-radius:15px 15px 0 0;
  }
  .level-one-greeting__angel{
    grid-column:1;
    grid-row:1 / span 2;
    max-height:56px;
  }
  .level-one-greeting__copy{grid-column:2;grid-row:1}
  .level-one-greeting__eyebrow{font-size:7px;margin-bottom:3px}
  .level-one-greeting__copy h2{font-size:14px}
  .level-one-greeting__copy p{font-size:10px;line-height:1.3}
  .level-one-greeting__start{
    grid-column:2;
    grid-row:2;
    justify-self:end;
    min-width:88px;
    min-height:32px;
    padding:6px 10px;
    font-size:8px;
  }
}
@media(orientation:landscape) and (max-height:480px){
  .level-one-greeting__card{
    height:20vh;
    min-height:76px;
    padding:6px 10% 5%;
    gap:8px;
  }
  .level-one-greeting__angel{max-height:48px}
  .level-one-greeting__eyebrow{font-size:7px}
  .level-one-greeting__copy h2{font-size:13px;margin-bottom:3px}
  .level-one-greeting__copy p{font-size:9px;line-height:1.25}
  .level-one-greeting__start{min-width:82px;min-height:29px}
}
@media(prefers-reduced-motion:reduce){
  .level-one-greeting__card{animation:none}
  .level-one-greeting__copy p.is-typing::after{animation:none}
  .level-one-greeting__start{transition:none}
}
